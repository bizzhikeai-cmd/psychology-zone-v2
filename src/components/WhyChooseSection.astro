---
// Why Choose Psychology Zone Section - Reusable Component
---

<section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <!-- Image -->
            <div class="relative order-2 lg:order-1">
                <div class="absolute -inset-4 bg-orange-gradient rounded-[2rem] opacity-10 blur-3xl"></div>
                <img
                    src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&q=80&w=1200"
                    alt="Professional consultation"
                    class="relative z-10 w-full h-[300px] sm:h-[400px] lg:h-[500px] object-cover rounded-xl sm:rounded-[2rem] shadow-2xl border-4 sm:border-8 border-white"
                >
            </div>

            <!-- Content -->
            <div class="order-1 lg:order-2">
                <h2 class="text-3xl sm:text-4xl lg:text-5xl mb-8 sm:mb-12 text-slate-900 serif">Why Choose Psychology Zone?</h2>
                <div class="space-y-6">
                    <div class="flex items-start gap-4">
                        <svg class="w-6 h-6 text-[#6B8E7B] flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900 mb-1">50+ Expert Psychologists</h3>
                            <p class="text-gray-600">RCI-licensed professionals with diverse specializations</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <svg class="w-6 h-6 text-[#6B8E7B] flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900 mb-1">Confidential & Secure Sessions</h3>
                            <p class="text-gray-600">256-bit SSL encryption and strict privacy protocols</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <svg class="w-6 h-6 text-[#6B8E7B] flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900 mb-1">Flexible Scheduling</h3>
                            <p class="text-gray-600">Morning, evening, and weekend slots available</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <svg class="w-6 h-6 text-[#6B8E7B] flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900 mb-1">Affordable Pricing</h3>
                            <p class="text-gray-600">Transparent pricing with packages starting at ₹799</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <svg class="w-6 h-6 text-[#6B8E7B] flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900 mb-1">24/7 Support Available</h3>
                            <p class="text-gray-600">Round-the-clock support for scheduling and queries</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <svg class="w-6 h-6 text-[#6B8E7B] flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900 mb-1">Evidence-Based Approach</h3>
                            <p class="text-gray-600">Proven therapeutic techniques tailored to your needs</p>
                        </div>
                    </div>
                </div>

                <!-- CTA -->
                <div class="mt-12">
                    <p class="text-gray-600 mb-4">Questions? Call us at <a href="tel:+918968900002" class="text-[#D35400] font-bold hover:underline">+91 89689 00002</a></p>
                    <a href="#pricing" class="inline-block bg-orange-gradient text-white px-8 py-4 sm:px-10 sm:py-5 rounded-full text-base sm:text-lg font-bold shadow-xl hover:shadow-orange-200 transition-all transform hover:-translate-y-1 min-h-[44px]">
                        Begin Your Journey
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
