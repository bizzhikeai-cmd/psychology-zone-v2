---
// PricingSection Component - Displays 3 pricing tiers with "Most Popular" highlight
interface Props {
  pageType: 'psychologist' | 'therapy' | 'couples';
}

const { pageType } = Astro.props;

const packages = [
  {
    id: 'starter',
    name: 'STARTER',
    sessions: 1,
    price: 649,
    priceInPaise: 64900,
    perSession: 649,
    discount: null,
    savings: null,
    features: [
      'Single 60-minute session',
      'Expert psychologist',
      'Confidential video session',
      'Flexible scheduling'
    ]
  },
  {
    id: 'popular',
    name: 'POPULAR',
    sessions: 5,
    price: 2595,
    priceInPaise: 259500,
    perSession: 519,
    discount: 20,
    savings: 650,
    features: [
      'Five 60-minute sessions',
      'Priority scheduling',
      'Same psychologist continuity',
      'Email support between sessions',
      'Progress tracking'
    ],
    recommended: true
  },
  {
    id: 'premium',
    name: 'PREMIUM',
    sessions: 10,
    price: 4870,
    priceInPaise: 487000,
    perSession: 487,
    discount: 25,
    savings: 1620,
    features: [
      'Ten 60-minute sessions',
      'Dedicated psychologist',
      'Priority scheduling',
      'Comprehensive progress reports',
      '24/7 email support',
      'Crisis support access'
    ]
  }
];
---

<section id="pricing" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl mb-6 text-slate-900" style="font-family: 'Lora', serif;">
        Choose Your Package
      </h2>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto">
        Flexible pricing options to support your mental wellness journey
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {packages.map((pkg) => (
        <div class={`relative bg-white rounded-3xl shadow-lg border-2 transition-all hover:shadow-xl ${
          pkg.recommended ? 'border-[#D35400] transform lg:-translate-y-4' : 'border-slate-100'
        }`}>
          {pkg.recommended && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-[#D35400] text-white text-xs font-bold uppercase tracking-widest px-6 py-2 rounded-full shadow-lg">
              Most Popular
            </div>
          )}

          <div class="p-8">
            {/* Header */}
            <div class="mb-8">
              <h4 class="text-xl font-bold mb-2 text-slate-900" style="font-family: 'Lora', serif;">
                {pkg.name}
              </h4>
              <p class="text-gray-500 text-sm">
                {pkg.sessions} {pkg.sessions === 1 ? 'Session' : 'Sessions'}
              </p>
            </div>

            {/* Pricing */}
            <div class="mb-8">
              <div class="flex items-baseline gap-2">
                <span class="text-5xl font-bold text-[#D35400]" style="font-family: 'Lora', serif;">
                  ₹{pkg.price.toLocaleString('en-IN')}
                </span>
                {pkg.discount && (
                  <span class="text-sm text-gray-400 line-through">
                    ₹{(pkg.sessions * 649).toLocaleString('en-IN')}
                  </span>
                )}
              </div>

              {pkg.perSession !== pkg.price && (
                <p class="text-sm text-gray-600 mt-2">
                  ₹{pkg.perSession}/session
                </p>
              )}

              {pkg.savings && (
                <div class="mt-3 inline-block bg-green-50 text-green-700 text-sm font-bold px-3 py-1 rounded-full">
                  SAVE ₹{pkg.savings}!
                </div>
              )}
            </div>

            {/* Features */}
            <ul class="space-y-4 mb-10">
              {pkg.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm">
                  <svg class="w-5 h-5 text-[#6B8E7B] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="text-gray-700">{feature}</span>
                </li>
              ))}
            </ul>

            {/* CTA Button */}
            <button
              class={`w-full py-4 rounded-xl font-bold transition-all transform hover:scale-105 select-package-btn ${
                pkg.recommended
                  ? 'bg-orange-gradient text-white shadow-lg shadow-orange-500/20'
                  : 'border-2 border-[#D35400] text-[#D35400] hover:bg-[#D35400] hover:text-white'
              }`}
              data-package-id={pkg.id}
              data-package-name={pkg.name}
              data-sessions={pkg.sessions}
              data-price={pkg.price}
              data-price-paise={pkg.priceInPaise}
              data-per-session={pkg.perSession}
              data-page-type={pageType}
            >
              Select Plan
            </button>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-12 text-center text-gray-400 text-sm italic">
      All packages include confidential video sessions with RCI-licensed psychologists
    </p>
  </div>
</section>

<style>
  .bg-orange-gradient {
    background: linear-gradient(135deg, #D35400 0%, #E67E22 100%);
  }
</style>

<script>
  // Package selection handler
  document.addEventListener('DOMContentLoaded', () => {
    const selectButtons = document.querySelectorAll('.select-package-btn');

    selectButtons.forEach(button => {
      button.addEventListener('click', () => {
        const packageId = button.getAttribute('data-package-id');
        const packageName = button.getAttribute('data-package-name');
        const sessions = button.getAttribute('data-sessions');
        const price = button.getAttribute('data-price');
        const pricePaise = button.getAttribute('data-price-paise');
        const perSession = button.getAttribute('data-per-session');
        const pageType = button.getAttribute('data-page-type');

        // Track GTM event
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'package_selected',
          package_id: packageId,
          package_name: packageName,
          sessions: sessions,
          price: price,
          page_type: pageType
        });

        // Store selected package in sessionStorage
        const selectedPackage = {
          id: packageId,
          name: packageName,
          sessions: parseInt(sessions),
          price: parseFloat(price),
          pricePaise: parseInt(pricePaise),
          perSession: parseFloat(perSession)
        };
        sessionStorage.setItem('selectedPackage', JSON.stringify(selectedPackage));

        // Dispatch custom event to update package display
        window.dispatchEvent(new CustomEvent('packageSelected', { detail: selectedPackage }));

        // Smooth scroll to booking form
        const bookingSection = document.getElementById('booking');
        if (bookingSection) {
          bookingSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

          // Add visual highlight
          setTimeout(() => {
            bookingSection.classList.add('highlight-pulse');
            setTimeout(() => {
              bookingSection.classList.remove('highlight-pulse');
            }, 2000);
          }, 500);
        }
      });
    });
  });
</script>
