---
import Layout from "../layouts/Layout.astro";
import WhyChooseSection from "../components/WhyChooseSection.astro";
import PricingSection from "../components/PricingSection.astro";
import BookingForm from "../components/BookingForm.astro";
---

<Layout
    title="Online Couples Therapy | Relationship Support & Counseling | Psychology Zone"
>
    <style>
        body { font-family: 'DM Sans', sans-serif; }
        .font-serif { font-family: 'Lora', serif; }
        .bg-orange-gradient { background: linear-gradient(135deg, #D35400 0%, #E67E22 100%); }
        .text-sage { color: #6B8E7B; }
        .bg-sage { background-color: #6B8E7B; }
        .bg-cream { background-color: #F8F5F0; }
    </style>

    <div class="min-h-screen bg-[#F8F5F0] text-slate-800">
        <!-- Navigation -->
        <nav class="fixed w-full z-50 bg-[#F8F5F0]/90 backdrop-blur-md border-b border-stone-200/60 top-0">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
                <a href="/" class="flex items-center">
                    <img src="/logo.png" alt="Psychology Zone" class="h-10 sm:h-12 w-auto" />
                </a>
                <div class="hidden lg:flex items-center gap-10 text-sm font-medium text-stone-600">
                    <a href="#services" id="nav-services" class="hover:text-[#D35400] transition-colors">Services</a>
                    <a href="#process" id="nav-process" class="hover:text-[#D35400] transition-colors">The Process</a>
                    <a href="#therapists" id="nav-therapists" class="hover:text-[#D35400] transition-colors">Clinicians</a>
                    <a href="#pricing" id="nav-pricing" class="hover:text-[#D35400] transition-colors">Pricing</a>
                </div>
                <a href="#pricing" id="header-cta" class="bg-orange-gradient text-white px-4 py-2 sm:px-7 sm:py-3 rounded-full text-xs sm:text-sm font-semibold shadow-lg shadow-orange-200 hover:scale-105 transition-transform whitespace-nowrap">Start My Journey</a>
            </div>
        </nav>

        <main class="pt-20">
            <!-- Hero Section -->
            <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-16 md:pt-24 md:pb-32 flex flex-col lg:flex-row items-center gap-10 sm:gap-16">
                <div class="lg:w-1/2 space-y-8">
                    <div class="inline-flex items-center gap-2 bg-[#6B8E7B]/10 text-[#6B8E7B] px-4 py-2 rounded-full text-sm font-medium">
                        <span>Relationship Support for Partners</span>
                    </div>
                    <h1 class="text-3xl sm:text-5xl md:text-7xl font-serif leading-[1.15] text-stone-900">
                        Reconnect & <span class="italic font-medium text-[#D35400]">Grow Stronger</span> Together
                    </h1>
                    <p class="text-lg md:text-xl text-stone-600 leading-relaxed max-w-xl font-light">
                        Strengthen your connection through modern, evidence-based therapy. Join sessions together or separately from the comfort of your home.
                    </p>
                    <div class="flex flex-col sm:flex-row flex-wrap gap-5">
                        <a href="#pricing" id="hero-cta-primary" class="w-full sm:w-auto bg-orange-gradient text-white px-8 py-4 sm:px-10 sm:py-5 rounded-3xl text-base sm:text-lg font-semibold shadow-xl shadow-orange-100 flex items-center justify-center gap-2 group transition-all min-h-[44px]">
                            Begin Your Journey
                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                        <div class="flex items-center gap-3 px-6 py-4">
                            <svg class="w-8 h-8 text-[#6B8E7B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                            <span class="text-stone-500 font-medium text-sm">Active participation encouraged<br>from both partners</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 pt-4 border-t border-stone-200 w-fit">
                        <div class="flex -space-x-3">
                            <img src="https://images.unsplash.com/photo-1512485694743-9c9538b4e6e0?auto=format&fit=crop&q=80&w=100" class="w-12 h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
                            <img src="https://images.unsplash.com/photo-1589156229687-496a31ad1d1f?auto=format&fit=crop&q=80&w=100" class="w-12 h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
                            <img src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&q=80&w=100" class="w-12 h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
                        </div>
                        <p class="text-sm text-stone-500 font-medium">Join 1,500+ happy clients finding peace</p>
                    </div>
                </div>
                <div class="lg:w-1/2 relative overflow-hidden">
                    <div class="absolute -top-10 -right-10 w-72 h-72 bg-orange-100 rounded-full blur-3xl opacity-50"></div>
                    <div class="absolute -bottom-10 -left-10 w-72 h-72 bg-[#6B8E7B]/20 rounded-full blur-3xl opacity-50"></div>
                    <div class="relative rounded-2xl sm:rounded-[3rem] overflow-hidden border-8 sm:border-[16px] border-white shadow-2xl transition-transform hover:scale-[1.01] duration-500">
                        <img src="https://images.unsplash.com/photo-1630132104043-463231362085?auto=format&fit=crop&q=80&w=1200" alt="Contemporary Indian couple" class="w-full aspect-[4/5] object-cover">
                    </div>
                    <div class="absolute top-10 right-2 sm:-right-8 bg-white/90 backdrop-blur p-4 sm:p-6 rounded-3xl shadow-xl border border-stone-100 max-w-[180px] sm:max-w-[200px] hidden sm:block">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
                            <span class="text-xs font-bold text-stone-400 uppercase tracking-widest">Now Available</span>
                        </div>
                        <p class="text-sm font-serif text-stone-800 leading-tight">Book a couples session for as early as today</p>
                    </div>
                </div>
            </section>

            <!-- Trust Numbers -->
            <section class="py-16 bg-gradient-to-r from-slate-800 to-slate-900">
                <div class="max-w-7xl mx-auto px-4 sm:px-6">
                    <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-12 font-serif">Trusted by thousands across India</h2>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 text-center">
                        <div>
                            <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">50+</div>
                            <div class="text-white/80 text-sm sm:text-base">Expert Psychologists</div>
                        </div>
                        <div>
                            <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">1.5k</div>
                            <div class="text-white/80 text-sm sm:text-base">Happy Clients</div>
                        </div>
                        <div>
                            <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">8.1k</div>
                            <div class="text-white/80 text-sm sm:text-base">Sessions Completed</div>
                        </div>
                        <div>
                            <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">10k+</div>
                            <div class="text-white/80 text-sm sm:text-base">Community Strong</div>
                        </div>
                    </div>
                    <p class="text-center text-white/60 mt-8 text-sm max-w-3xl mx-auto">Your privacy is sacred. Every session remains completely confidential between you and your therapist.</p>
                </div>
            </section>

            <!-- Services Grid -->
            <section id="services" class="bg-white py-24">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="text-center mb-16 space-y-4">
                        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900">Focused Relationship Care</h2>
                        <p class="text-stone-500 max-w-2xl mx-auto text-lg">We specialize in the complex dynamics that define modern partnerships.</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-[#6B8E7B] hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-[#6B8E7B] group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Communication Patterns</h3>
                            <p class="text-stone-500 leading-relaxed">Identify and break the cycles of criticism, defensiveness, and stonewalling that stall your connection.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-orange-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-[#E67E22] group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Recurring Conflicts</h3>
                            <p class="text-stone-500 leading-relaxed">Navigate those 'unsolvable' arguments by uncovering the underlying emotional needs beneath the surface.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-indigo-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-indigo-500 group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Trust & Connection</h3>
                            <p class="text-stone-500 leading-relaxed">Heal from betrayal or long-term distance by rebuilding a secure emotional foundation and transparency.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-rose-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-rose-500 group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Life Transitions</h3>
                            <p class="text-stone-500 leading-relaxed">Stay aligned while navigating parenthood, career shifts, relocation, or aging together as a unified team.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-amber-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-amber-500 group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Intimacy & Spark</h3>
                            <p class="text-stone-500 leading-relaxed">Rediscover physical and emotional intimacy through trauma-informed and vulnerability-focused exploration.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-emerald-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-emerald-500 group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Balancing Expectations</h3>
                            <p class="text-stone-500 leading-relaxed">Align on household labor, finances, and personal boundaries to ensure both partners feel valued.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Couples Process -->
            <section id="process" class="py-24 bg-[#6B8E7B] text-white">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="grid lg:grid-cols-2 gap-20 items-center">
                        <div>
                            <h2 class="text-3xl sm:text-4xl lg:text-5xl mb-8 font-serif">The Relationship Roadmap</h2>
                            <p class="text-white/80 text-lg mb-12">Our 4-step process ensures both partners are heard, respected, and empowered to grow.</p>
                            <div class="space-y-8">
                                <div class="flex gap-6">
                                    <span class="flex-shrink-0 w-12 h-12 rounded-full border-2 border-white/30 flex items-center justify-center font-bold text-xl">1</span>
                                    <div>
                                        <h4 class="text-xl font-bold mb-2">Joint Discovery</h4>
                                        <p class="text-white/70">An initial session with both partners to identify common goals and the 'elephant in the room'.</p>
                                    </div>
                                </div>
                                <div class="flex gap-6">
                                    <span class="flex-shrink-0 w-12 h-12 rounded-full border-2 border-white/30 flex items-center justify-center font-bold text-xl">2</span>
                                    <div>
                                        <h4 class="text-xl font-bold mb-2">Individual Mapping</h4>
                                        <p class="text-white/70">Optional solo sessions for each partner to explore personal history and attachment styles without pressure.</p>
                                    </div>
                                </div>
                                <div class="flex gap-6">
                                    <span class="flex-shrink-0 w-12 h-12 rounded-full border-2 border-white/30 flex items-center justify-center font-bold text-xl">3</span>
                                    <div>
                                        <h4 class="text-xl font-bold mb-2">Skill Implementation</h4>
                                        <p class="text-white/70">Weekly sessions focusing on real-world tools for communication, conflict de-escalation, and bonding.</p>
                                    </div>
                                </div>
                                <div class="flex gap-6">
                                    <span class="flex-shrink-0 w-12 h-12 rounded-full border-2 border-white/30 flex items-center justify-center font-bold text-xl">4</span>
                                    <div>
                                        <h4 class="text-xl font-bold mb-2">Sustainable Union</h4>
                                        <p class="text-white/70">Building long-term rituals of connection to ensure your relationship continues to thrive independently.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <img src="https://images.unsplash.com/photo-1621252179027-94459d278660?auto=format&fit=crop&q=80&w=600" alt="Couple talking calmly" class="rounded-2xl shadow-2xl mt-12">
                            <img src="https://images.unsplash.com/photo-1620932900741-236b28005856?auto=format&fit=crop&q=80&w=600" alt="Supportive gesture" class="rounded-2xl shadow-2xl">
                        </div>
                    </div>
                </div>
            </section>

            <!-- Therapist Profiles -->
            <section id="therapists" class="py-24 max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900 mb-6">Meet Our Relationship Specialists</h2>
                    <p class="text-stone-500 max-w-2xl mx-auto">Expert clinicians trained in Gottman Method, EFT, and trauma-informed couples care.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-pooja.webp" alt="Ms. Pooja" class="w-full h-full object-cover object-top" width="400" height="399" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Ms. Pooja</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Relationship Expert</p>
                        <p class="text-sm text-stone-500 leading-relaxed">5+ years • M.A. Counseling • Specializes in relationship counseling and family therapy</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-lekha.webp" alt="Lekha Murali" class="w-full h-full object-cover object-top" width="593" height="949" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Lekha Murali</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Clinical Director</p>
                        <p class="text-sm text-stone-500 leading-relaxed">19+ years • PhD Psychology • Clinical psychology, psychotherapy, and guidance counseling</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-jyotsna.jpg" alt="Dr. Jaismeen Kaur" class="w-full h-full object-cover object-top" width="601" height="800" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Dr. Jaismeen Kaur</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Choice Theory & Reality Therapy</p>
                        <p class="text-sm text-stone-500 leading-relaxed">6+ years • William Glasser Institute (USA) • PhD, MSc, PGDGC</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-jaismeen.jpg" alt="Jyotsna Mohanta" class="w-full h-full object-cover object-top" width="800" height="600" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Jyotsna Mohanta</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">NLP Expert & Life Coach</p>
                        <p class="text-sm text-stone-500 leading-relaxed">7+ years • PhD, MSc, PGDGC • Mental wellness and personal growth specialist</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-sharmila.jpg" alt="Sharmila Masih" class="w-full h-full object-cover object-top" width="424" height="453" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Sharmila Masih</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Clinical Psychologist</p>
                        <p class="text-sm text-stone-500 leading-relaxed">7+ years • M.A. Clinical Psychology • Child development counseling and mental health</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-sukriti.webp" alt="Ms. Sukriti" class="w-full h-full object-cover object-top" width="300" height="300" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Ms. Sukriti</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Clinical & Counseling Psychologist</p>
                        <p class="text-sm text-stone-500 leading-relaxed">7+ years • M.A. Psychology • Organizational psychology specialist</p>
                    </div>
                </div>
            </section>

            <!-- Testimonials -->
            <section class="py-24 bg-[#F8F5F0]">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-16">
                        <div class="max-w-xl">
                            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900 mb-6">What Couples <span class="text-[#6B8E7B] italic">Say</span></h2>
                            <p class="text-stone-600">Real experiences from partners who strengthened their bond.</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        <div class="bg-white p-6 sm:p-12 rounded-2xl sm:rounded-[3.5rem] shadow-sm flex flex-col justify-between">
