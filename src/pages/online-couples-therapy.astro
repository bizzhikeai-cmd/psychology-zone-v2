---
import Layout from "../layouts/Layout.astro";
import WhyChooseSection from "../components/WhyChooseSection.astro";
import PricingSection from "../components/PricingSection.astro";
import BookingForm from "../components/BookingForm.astro";
---

<Layout
    title="Online Couples Therapy | Relationship Support & Counseling | Psychology Zone"
>
    <style>
        :root {
            --cream: #F8F5F0;
            --sage: #6B8E7B;
            --orange-start: #D35400;
            --orange-end: #E67E22;
            --text-dark: #2C3E50;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--cream);
            color: var(--text-dark);
            scroll-behavior: smooth;
        }
        h1, h2, h3, .serif {
            font-family: 'Lora', serif;
        }
        .bg-orange-gradient {
            background: linear-gradient(135deg, var(--orange-start) 0%, var(--orange-end) 100%);
        }
        .nav-blur {
            backdrop-filter: blur(12px);
            background-color: rgba(248, 245, 240, 0.9);
        }
    </style>

    <div class="min-h-screen flex flex-col">
        <!-- Header -->
        <header class="fixed top-0 left-0 right-0 z-50 nav-blur border-b border-black/5">
            <nav class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
                <a href="#" id="nav-logo" class="flex items-center gap-2">
                    <div class="flex items-center justify-center p-1.5 bg-orange-50 rounded-lg border border-orange-200">
                        <div class="w-9 h-9 bg-orange-gradient rounded-md flex items-center justify-center shadow-inner transform rotate-3">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="flex flex-col leading-none">
                        <span class="text-2xl font-black text-[#D35400] tracking-tighter serif">PSYCHOLOGY</span>
                        <span class="text-sm font-bold text-gray-400 tracking-[0.2em] uppercase -mt-0.5 ml-0.5">ZONE</span>
                    </div>
                </a>
                <div class="hidden md:flex items-center space-x-8 text-sm font-semibold text-gray-700">
                    <a href="#services" id="nav-services" class="hover:text-[#D35400] transition-colors">Services</a>
                    <a href="#process" id="nav-process" class="hover:text-[#D35400] transition-colors">The Process</a>
                    <a href="#therapists" id="nav-therapists" class="hover:text-[#D35400] transition-colors">Clinicians</a>
                    <a href="#pricing" id="nav-pricing" class="hover:text-[#D35400] transition-colors">Pricing</a>
                    <a href="#faq" id="nav-faq" class="hover:text-[#D35400] transition-colors">FAQ</a>
                </div>
                <a href="#pricing" id="header-cta" class="bg-orange-gradient text-white px-6 py-2.5 rounded-full text-sm font-bold shadow-lg hover:shadow-orange-500/20 transition-all">
                    Begin Your Journey
                </a>
            </nav>
        </header>

        <main class="pt-20">
            <!-- Hero Section -->
            <section class="relative py-20 lg:py-32 px-6 overflow-hidden">
                <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
                    <div class="relative z-10">
                        <span class="inline-block px-4 py-1 bg-[#6B8E7B]/10 text-[#6B8E7B] rounded-full text-xs font-bold uppercase tracking-widest mb-6">
                            Relationship Support for Partners
                        </span>
                        <h1 class="text-5xl lg:text-7xl leading-tight mb-8 text-slate-900 serif">
                            Online <br/><span class="text-[#D35400] italic">Couples</span> Therapy
                        </h1>
                        <p class="text-xl text-gray-600 mb-10 leading-relaxed max-w-lg">
                            Strengthen your connection through modern, evidence-based therapy. Join sessions together or separately from the comfort of your home.
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4">
                            <a href="#pricing" id="hero-cta-primary" class="bg-orange-gradient text-white px-8 py-4 rounded-xl text-lg font-bold text-center hover:scale-105 transition-transform shadow-xl shadow-orange-500/30">
                                Begin Your Journey
                            </a>
                            <a href="#services" id="hero-cta-secondary" class="bg-white border-2 border-slate-100 text-slate-700 px-8 py-4 rounded-xl text-lg font-bold text-center hover:bg-slate-50 transition-colors">
                                Learn More
                            </a>
                        </div>
                        <div class="mt-8 flex items-center gap-3 text-sm text-gray-500 font-medium">
                            <svg class="w-5 h-5 text-[#6B8E7B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                            </svg>
                            <span>Active participation encouraged from both partners</span>
                        </div>
                    </div>
                    <div class="relative">
                        <div class="absolute -inset-4 bg-orange-gradient rounded-[2rem] opacity-10 blur-3xl"></div>
                        <img src="https://images.unsplash.com/photo-1630132104043-463231362085?auto=format&fit=crop&q=80&w=1200" alt="Contemporary Indian couple" class="relative z-10 w-full h-[500px] object-cover rounded-[2rem] shadow-2xl border-8 border-white">
                        <div class="absolute bottom-8 -left-8 z-20 bg-white p-6 rounded-2xl shadow-xl max-w-xs hidden md:block border-l-4 border-[#6B8E7B]">
                            <p class="text-sm italic text-gray-600 leading-relaxed font-medium">
                                "We learned to hear each other again. The separate sessions helped us bring our best selves back to the relationship."
                            </p>
                            <span class="block mt-2 text-xs font-bold text-[#D35400]">— Priya & Sameer, Clients</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Trust Numbers -->
            <section class="py-16 bg-gradient-to-r from-slate-800 to-slate-900">
                <div class="max-w-7xl mx-auto px-6">
                    <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-12 serif">Trusted by thousands across India</h2>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                        <div>
                            <div class="text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">50+</div>
                            <div class="text-white/80">Expert Psychologists</div>
                        </div>
                        <div>
                            <div class="text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">1.5k</div>
                            <div class="text-white/80">Happy Clients</div>
                        </div>
                        <div>
                            <div class="text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">8.1k</div>
                            <div class="text-white/80">Sessions Completed</div>
                        </div>
                        <div>
                            <div class="text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">10k+</div>
                            <div class="text-white/80">Community Strong</div>
                        </div>
                    </div>
                    <p class="text-center text-white/60 mt-8 text-sm max-w-3xl mx-auto">Your privacy is sacred. Every session remains completely confidential between you and your therapist.</p>
                </div>
            </section>

            <!-- Services Grid -->
            <section id="services" class="py-24 bg-white">
                <div class="max-w-7xl mx-auto px-6 text-center mb-16">
                    <h2 class="text-4xl lg:text-5xl mb-6 text-slate-900 serif">Focused Relationship Care</h2>
                    <p class="text-gray-500 max-w-2xl mx-auto text-lg">We specialize in the complex dynamics that define modern partnerships.</p>
                </div>
                <div class="max-w-7xl mx-auto px-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="p-8 rounded-3xl bg-[#F8F5F0] hover:shadow-xl transition-shadow border border-transparent hover:border-[#D35400]/20">
                        <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-[#D35400] text-3xl mb-6 shadow-sm">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                            </svg>
                        </div>
                        <h3 class="text-2xl mb-4 font-bold serif">Communication Patterns</h3>
                        <p class="text-gray-600 leading-relaxed">Identify and break the cycles of criticism, defensiveness, and stonewalling that stall your connection.</p>
                    </div>
                    <div class="p-8 rounded-3xl bg-[#F8F5F0] hover:shadow-xl transition-shadow border border-transparent hover:border-[#D35400]/20">
                        <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-[#D35400] text-3xl mb-6 shadow-sm">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                            </svg>
                        </div>
                        <h3 class="text-2xl mb-4 font-bold serif">Recurring Conflicts</h3>
                        <p class="text-gray-600 leading-relaxed">Navigate those 'unsolvable' arguments by uncovering the underlying emotional needs beneath the surface.</p>
                    </div>
                    <div class="p-8 rounded-3xl bg-[#F8F5F0] hover:shadow-xl transition-shadow border border-transparent hover:border-[#D35400]/20">
                        <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-[#D35400] text-3xl mb-6 shadow-sm">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                        </div>
                        <h3 class="text-2xl mb-4 font-bold serif">Trust & Connection</h3>
                        <p class="text-gray-600 leading-relaxed">Heal from betrayal or long-term distance by rebuilding a secure emotional foundation and transparency.</p>
                    </div>
                    <div class="p-8 rounded-3xl bg-[#F8F5F0] hover:shadow-xl transition-shadow border border-transparent hover:border-[#D35400]/20">
                        <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-[#D35400] text-3xl mb-6 shadow-sm">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                            </svg>
                        </div>
                        <h3 class="text-2xl mb-4 font-bold serif">Life Transitions</h3>
                        <p class="text-gray-600 leading-relaxed">Stay aligned while navigating parenthood, career shifts, relocation, or aging together as a unified team.</p>
                    </div>
                    <div class="p-8 rounded-3xl bg-[#F8F5F0] hover:shadow-xl transition-shadow border border-transparent hover:border-[#D35400]/20">
                        <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-[#D35400] text-3xl mb-6 shadow-sm">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/>
                            </svg>
                        </div>
                        <h3 class="text-2xl mb-4 font-bold serif">Intimacy & Spark</h3>
                        <p class="text-gray-600 leading-relaxed">Rediscover physical and emotional intimacy through trauma-informed and vulnerability-focused exploration.</p>
                    </div>
                    <div class="p-8 rounded-3xl bg-[#F8F5F0] hover:shadow-xl transition-shadow border border-transparent hover:border-[#D35400]/20">
                        <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-[#D35400] text-3xl mb-6 shadow-sm">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                            </svg>
                        </div>
                        <h3 class="text-2xl mb-4 font-bold serif">Balancing Expectations</h3>
                        <p class="text-gray-600 leading-relaxed">Align on household labor, finances, and personal boundaries to ensure both partners feel valued.</p>
                    </div>
                </div>
            </section>

            <!-- Couples Process -->
            <section id="process" class="py-24 bg-[#6B8E7B] text-white">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="grid lg:grid-cols-2 gap-20 items-center">
                        <div>
                            <h2 class="text-4xl lg:text-5xl mb-8 serif">The Relationship Roadmap</h2>
                            <p class="text-white/80 text-lg mb-12">Our 4-step process ensures both partners are heard, respected, and empowered to grow.</p>
                            <div class="space-y-8">
                                <div class="flex gap-6">
                                    <span class="flex-shrink-0 w-12 h-12 rounded-full border-2 border-white/30 flex items-center justify-center font-bold text-xl">1</span>
                                    <div>
                                        <h4 class="text-xl font-bold mb-2">Joint Discovery</h4>
                                        <p class="text-white/70">An initial session with both partners to identify common goals and the 'elephant in the room'.</p>
                                    </div>
                                </div>
                                <div class="flex gap-6">
                                    <span class="flex-shrink-0 w-12 h-12 rounded-full border-2 border-white/30 flex items-center justify-center font-bold text-xl">2</span>
                                    <div>
                                        <h4 class="text-xl font-bold mb-2">Individual Mapping</h4>
                                        <p class="text-white/70">Optional solo sessions for each partner to explore personal history and attachment styles without pressure.</p>
                                    </div>
                                </div>
                                <div class="flex gap-6">
                                    <span class="flex-shrink-0 w-12 h-12 rounded-full border-2 border-white/30 flex items-center justify-center font-bold text-xl">3</span>
                                    <div>
                                        <h4 class="text-xl font-bold mb-2">Skill Implementation</h4>
                                        <p class="text-white/70">Weekly sessions focusing on real-world tools for communication, conflict de-escalation, and bonding.</p>
                                    </div>
                                </div>
                                <div class="flex gap-6">
                                    <span class="flex-shrink-0 w-12 h-12 rounded-full border-2 border-white/30 flex items-center justify-center font-bold text-xl">4</span>
                                    <div>
                                        <h4 class="text-xl font-bold mb-2">Sustainable Union</h4>
                                        <p class="text-white/70">Building long-term rituals of connection to ensure your relationship continues to thrive independently.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <img src="https://images.unsplash.com/photo-1621252179027-94459d278660?auto=format&fit=crop&q=80&w=600" alt="Couple talking calmly" class="rounded-2xl shadow-2xl mt-12">
                            <img src="https://images.unsplash.com/photo-1620932900741-236b28005856?auto=format&fit=crop&q=80&w=600" alt="Supportive gesture" class="rounded-2xl shadow-2xl">
                        </div>
                    </div>
                </div>
            </section>

            <!-- Therapist Profiles -->
            <section id="therapists" class="py-24 bg-white">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-4">
                        <div class="max-w-2xl">
                            <h2 class="text-4xl lg:text-5xl mb-4 text-slate-900 serif">Meet Our Relationship Specialists</h2>
                            <p class="text-gray-500 text-lg">Expert clinicians trained in Gottman Method, EFT, and trauma-informed couples care.</p>
                        </div>
                        <a href="#" id="all-therapists-link" class="text-[#D35400] font-bold flex items-center gap-2 hover:underline">
                            Browse All Experts
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </div>
                    <div class="grid md:grid-cols-3 gap-8">
                        <div class="group bg-[#F8F5F0] rounded-3xl overflow-hidden hover:shadow-xl transition-all">
                            <div class="h-72 overflow-hidden">
                                <img src="/images/therapist-pooja.webp" alt="Ms. Pooja" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            </div>
                            <div class="p-8">
                                <span class="text-[#6B8E7B] font-bold text-xs uppercase tracking-widest mb-2 block">Relationship Expert</span>
                                <h4 class="text-2xl font-bold mb-2 serif">Ms. Pooja</h4>
                                <p class="text-sm text-gray-500 mb-4 italic">M.A. Counseling • 5+ years</p>
                                <p class="text-gray-600 text-sm leading-relaxed">Specializes in relationship counseling and family therapy</p>
                            </div>
                        </div>
                        <div class="group bg-[#F8F5F0] rounded-3xl overflow-hidden hover:shadow-xl transition-all">
                            <div class="h-72 overflow-hidden">
                                <img src="/images/therapist-lekha.webp" alt="Lekha Murali" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            </div>
                            <div class="p-8">
                                <span class="text-[#6B8E7B] font-bold text-xs uppercase tracking-widest mb-2 block">Clinical Director</span>
                                <h4 class="text-2xl font-bold mb-2 serif">Lekha Murali</h4>
                                <p class="text-sm text-gray-500 mb-4 italic">PhD Psychology • 19+ years</p>
                                <p class="text-gray-600 text-sm leading-relaxed">Clinical psychology, psychotherapy, and guidance counseling</p>
                            </div>
                        </div>
                        <div class="group bg-[#F8F5F0] rounded-3xl overflow-hidden hover:shadow-xl transition-all">
                            <div class="h-72 overflow-hidden">
                                <img src="/images/therapist-jyotsna.jpg" alt="Dr. Jaismeen Kaur" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            </div>
                            <div class="p-8">
                                <span class="text-[#6B8E7B] font-bold text-xs uppercase tracking-widest mb-2 block">Choice Theory Expert</span>
                                <h4 class="text-2xl font-bold mb-2 serif">Dr. Jaismeen Kaur</h4>
                                <p class="text-sm text-gray-500 mb-4 italic">PhD • William Glasser Institute (USA) • 6+ years</p>
                                <p class="text-gray-600 text-sm leading-relaxed">Reality therapy and modern relationship dynamics</p>
                            </div>
                        </div>
                        <div class="group bg-[#F8F5F0] rounded-3xl overflow-hidden hover:shadow-xl transition-all">
                            <div class="h-72 overflow-hidden">
                                <img src="/images/therapist-jaismeen.jpg" alt="Jyotsna Mohanta" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            </div>
                            <div class="p-8">
                                <span class="text-[#6B8E7B] font-bold text-xs uppercase tracking-widest mb-2 block">NLP Expert</span>
                                <h4 class="text-2xl font-bold mb-2 serif">Jyotsna Mohanta</h4>
                                <p class="text-sm text-gray-500 mb-4 italic">PhD, MSc, PGDGC • 7+ years</p>
                                <p class="text-gray-600 text-sm leading-relaxed">Mental wellness and personal growth specialist</p>
                            </div>
                        </div>
                        <div class="group bg-[#F8F5F0] rounded-3xl overflow-hidden hover:shadow-xl transition-all">
                            <div class="h-72 overflow-hidden">
                                <img src="/images/therapist-sharmila.jpg" alt="Sharmila Masih" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            </div>
                            <div class="p-8">
                                <span class="text-[#6B8E7B] font-bold text-xs uppercase tracking-widest mb-2 block">Clinical Psychologist</span>
                                <h4 class="text-2xl font-bold mb-2 serif">Sharmila Masih</h4>
                                <p class="text-sm text-gray-500 mb-4 italic">M.A. Clinical Psychology • 7+ years</p>
                                <p class="text-gray-600 text-sm leading-relaxed">Child development counseling and mental health</p>
                            </div>
                        </div>
                        <div class="group bg-[#F8F5F0] rounded-3xl overflow-hidden hover:shadow-xl transition-all">
                            <div class="h-72 overflow-hidden">
                                <img src="/images/therapist-sukriti.webp" alt="Ms. Sukriti" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            </div>
                            <div class="p-8">
                                <span class="text-[#6B8E7B] font-bold text-xs uppercase tracking-widest mb-2 block">Clinical Psychologist</span>
                                <h4 class="text-2xl font-bold mb-2 serif">Ms. Sukriti</h4>
                                <p class="text-sm text-gray-500 mb-4 italic">M.A. Psychology • 7+ years</p>
                                <p class="text-gray-600 text-sm leading-relaxed">Organizational psychology specialist</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Testimonials -->
            <section class="py-24 bg-slate-800">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="text-center mb-16">
                        <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4 serif">What Couples Say</h2>
                        <p class="text-white/70">Real experiences from partners who strengthened their bond.</p>
                    </div>
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                        <div class="bg-slate-700/50 p-8 rounded-3xl backdrop-blur-sm border border-white/10">
