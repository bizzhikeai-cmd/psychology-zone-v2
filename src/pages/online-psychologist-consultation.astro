                <div class="absolute -top-10 -right-10 w-64 h-64 bg-orange-200/40 rounded-full blur-3xl -z-10"></div>
                <div class="absolute -bottom-10 -left-10 w-64 h-64 bg-[#6B8E7B]/20 rounded-full blur-3xl -z-10"></div>
            </div>
        </div>
    </section>

    <!-- Trust Numbers -->
    <section class="py-16 bg-gradient-to-r from-slate-800 to-slate-900">
        <div class="max-w-7xl mx-auto px-6">
