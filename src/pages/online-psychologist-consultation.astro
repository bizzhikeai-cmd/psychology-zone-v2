---
import Layout from "../layouts/Layout.astro";
import WhyChooseSection from "../components/WhyChooseSection.astro";
import PricingSection from "../components/PricingSection.astro";
import BookingForm from "../components/BookingForm.astro";
---

<Layout title="Online Psychologist Consultation | RCI-Licensed Psychologists | Psychology Zone">
    <!-- Header -->
    <nav class="fixed w-full z-50 bg-white/90 backdrop-blur-md border-b border-orange-100 top-0">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="flex items-center gap-2">
                    <div class="flex items-center justify-center p-1.5 bg-orange-50 rounded-lg border border-orange-200">
                        <div class="w-9 h-9 bg-orange-gradient rounded-md flex items-center justify-center shadow-inner transform rotate-3">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="flex flex-col leading-none">
                        <span class="text-2xl font-black text-[#D35400] tracking-tighter" style="font-family: 'Lora', serif;">PSYCHOLOGY</span>
                        <span class="text-sm font-bold text-gray-400 tracking-[0.2em] uppercase -mt-0.5 ml-0.5">ZONE</span>
                    </div>
                </div>
            </div>
            <div class="hidden lg:flex items-center gap-10 text-sm font-semibold text-gray-700">
                <a href="#services" class="hover:text-[#D35400] transition-colors">Our Services</a>
                <a href="#how-it-works" class="hover:text-[#D35400] transition-colors">How it Works</a>
                <a href="#experts" class="hover:text-[#D35400] transition-colors">Our Experts</a>
                <a href="#pricing" class="hover:text-[#D35400] transition-colors">Pricing</a>
            </div>
            <div class="flex items-center gap-4">
                <a href="tel:+918968900002" class="hidden sm:flex items-center gap-2 text-sm font-bold text-gray-800">
                    <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    +91 89689 00002
                </a>
                <a href="#booking" class="bg-orange-gradient text-white px-6 py-2.5 rounded-full text-sm font-bold shadow-md hover:shadow-lg transition-all transform hover:scale-105">Book My Session</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="pt-32 pb-24 px-6 relative overflow-hidden bg-gradient-to-br from-[#FFF7ED] to-[#F8F5F0]">
        <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-12">
            <div class="flex-1 space-y-8">
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-orange-50 border border-orange-100 text-[#D35400] text-sm font-bold rounded-full shadow-sm">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    4.7★ Rating from 18,500+ Sessions
                </div>
                <h1 class="text-5xl lg:text-7xl font-bold leading-tight text-gray-900" style="font-family: 'Lora', serif;">
                    Professional <span class="text-[#D35400]">Online</span> Psychologist Consultation
                </h1>
                <p class="text-xl text-gray-600 max-w-2xl leading-relaxed">
                    Access professional psychological support through secure online sessions. Connect with RCI-licensed psychologists who can help you work through stress, emotional concerns, relationship challenges, and life transitions using evidence-based approaches. <strong>Outcomes may vary based on individual circumstances.</strong>
                </p>
                <div class="flex flex-wrap gap-4">
                    <span class="flex items-center gap-1 text-sm font-medium px-3 py-1 bg-white rounded-full border border-gray-100 text-gray-600">
