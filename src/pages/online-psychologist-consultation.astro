                    <p class="text-gray-600 text-sm leading-relaxed">PhD, MSc, MS, PGDGC</p>
                </div>
                <div class="bg-white p-8 rounded-3xl shadow-sm hover:shadow-xl transition-shadow">
                    <div class="mb-6">
                        <img src="/images/therapist-jaismeen.jpg" alt="Jyotsna Mohanta" class="w-full h-64 object-cover rounded-2xl">
