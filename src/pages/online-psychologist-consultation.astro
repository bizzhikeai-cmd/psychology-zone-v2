                </div>
                <div class="bg-white p-8 rounded-3xl shadow-sm hover:shadow-xl transition-shadow">
                    <div class="mb-6">
                        <img src="/images/therapist-sharmila.jpg" alt="Sharmila Masih" class="w-full h-64 object-cover rounded-2xl">
                    </div>
