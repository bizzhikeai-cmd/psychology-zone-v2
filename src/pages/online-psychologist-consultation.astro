                    </div>
                    <h3 class="text-2xl font-bold mb-2" style="font-family: 'Lora', serif;">Ms. Pooja</h3>
                    <p class="text-[#6B8E7B] font-semibold mb-2">Relationship & Mental Health Expert</p>
                    <p class="text-sm text-gray-500 mb-4">5+ years • Relationship Counseling, Family Therapy</p>
                    <p class="text-gray-600 text-sm leading-relaxed">M.A. Counseling</p>
                </div>
                <div class="bg-white p-8 rounded-3xl shadow-sm hover:shadow-xl transition-shadow">
                    <div class="mb-6">
                        <img src="/images/therapist-sukriti.webp" alt="Ms. Sukriti" class="w-full h-64 object-cover rounded-2xl">
                    </div>
                    <h3 class="text-2xl font-bold mb-2" style="font-family: 'Lora', serif;">Ms. Sukriti</h3>
