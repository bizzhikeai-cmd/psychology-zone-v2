---
import Layout from "../layouts/Layout.astro";
import WhyChooseSection from "../components/WhyChooseSection.astro";
import PricingSection from "../components/PricingSection.astro";
import BookingForm from "../components/BookingForm.astro";
---

<Layout title="Online Psychologist Consultation | RCI-Licensed Psychologists | Psychology Zone">
    <style>
        body { font-family: 'DM Sans', sans-serif; }
        .font-serif { font-family: 'Lora', serif; }
        .bg-orange-gradient { background: linear-gradient(135deg, #D35400 0%, #E67E22 100%); }
        .text-sage { color: #6B8E7B; }
        .bg-sage { background-color: #6B8E7B; }
        .bg-cream { background-color: #F8F5F0; }
    </style>

    <div class="min-h-screen bg-[#F8F5F0] text-slate-800">
        <!-- Navigation -->
        <nav class="fixed w-full z-50 bg-[#F8F5F0]/90 backdrop-blur-md border-b border-stone-200/60 top-0">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
                <a href="/" class="flex items-center">
                    <img src="/logo.png" alt="Psychology Zone" class="h-10 sm:h-12 w-auto" />
                </a>
                <div class="hidden lg:flex items-center gap-10 text-sm font-medium text-stone-600">
                    <a href="#services" class="hover:text-[#D35400] transition-colors">Our Services</a>
                    <a href="#how-it-works" class="hover:text-[#D35400] transition-colors">How it Works</a>
                    <a href="#experts" class="hover:text-[#D35400] transition-colors">Our Experts</a>
                    <a href="#pricing" class="hover:text-[#D35400] transition-colors">Pricing</a>
                </div>
                <a href="#pricing" id="nav-book-btn" class="bg-orange-gradient text-white px-4 py-2 sm:px-7 sm:py-3 rounded-full text-xs sm:text-sm font-semibold shadow-lg shadow-orange-200 hover:scale-105 transition-transform whitespace-nowrap">Start My Journey</a>
            </div>
        </nav>

        <main class="pt-20">
            <!-- Hero Section -->
            <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-16 md:pt-24 md:pb-32 flex flex-col lg:flex-row items-center gap-10 sm:gap-16">
                <div class="lg:w-1/2 space-y-8">
                    <div class="inline-flex items-center gap-2 px-4 py-2 bg-orange-50 border border-orange-100 text-[#D35400] text-sm font-bold rounded-full shadow-sm">
                        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                        4.7 Rating from 18,500+ Sessions
                    </div>
                    <h1 class="text-3xl sm:text-5xl lg:text-7xl font-serif leading-[1.15] text-stone-900">
                        Feel Heard by an <span class="italic font-medium text-[#D35400]">Expert</span> Psychologist — Online
                    </h1>
                    <p class="text-lg md:text-xl text-stone-600 leading-relaxed max-w-xl font-light">
                        Access professional psychological support through secure online sessions. Connect with RCI-licensed psychologists who can help you work through stress, emotional concerns, relationship challenges, and life transitions using evidence-based approaches. <strong>Outcomes may vary based on individual circumstances.</strong>
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <span class="flex items-center gap-1 text-sm font-medium px-3 py-1 bg-white rounded-full border border-gray-100 text-gray-600">
                            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> RCI Licensed
                        </span>
                        <span class="flex items-center gap-1 text-sm font-medium px-3 py-1 bg-white rounded-full border border-gray-100 text-gray-600">
                            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> 100% Confidential
                        </span>
                        <span class="flex items-center gap-1 text-sm font-medium px-3 py-1 bg-white rounded-full border border-gray-100 text-gray-600">
                            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Evidence-Based
                        </span>
                    </div>
                    <div class="flex flex-col sm:flex-row flex-wrap gap-5">
                        <a href="#pricing" id="hero-cta-primary" class="w-full sm:w-auto bg-orange-gradient text-white px-8 py-4 sm:px-10 sm:py-5 rounded-3xl text-base sm:text-lg font-semibold shadow-xl shadow-orange-100 flex items-center justify-center gap-2 group transition-all min-h-[44px]">
                            Begin Your Journey
                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                        <div class="flex items-center gap-3 px-6 py-4">
                            <svg class="w-8 h-8 text-[#6B8E7B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                            <span class="text-stone-500 font-medium text-sm">₹599 per session<br>Individual outcomes may vary</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 pt-4 border-t border-stone-200 w-fit">
                        <div class="flex -space-x-3">
                            <img src="https://images.unsplash.com/photo-1512485694743-9c9538b4e6e0?auto=format&fit=crop&q=80&w=100" class="w-12 h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
                            <img src="https://images.unsplash.com/photo-1589156229687-496a31ad1d1f?auto=format&fit=crop&q=80&w=100" class="w-12 h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
                            <img src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&q=80&w=100" class="w-12 h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
                        </div>
                        <p class="text-sm text-stone-500 font-medium">Join 1,500+ happy clients finding peace</p>
                    </div>
                </div>
                <div class="lg:w-1/2 relative overflow-hidden">
                    <div class="absolute -top-10 -right-10 w-72 h-72 bg-orange-100 rounded-full blur-3xl opacity-50"></div>
                    <div class="absolute -bottom-10 -left-10 w-72 h-72 bg-[#6B8E7B]/20 rounded-full blur-3xl opacity-50"></div>
                    <div class="relative rounded-2xl sm:rounded-[3rem] overflow-hidden border-8 sm:border-[16px] border-white shadow-2xl transition-transform hover:scale-[1.01] duration-500">
                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=1000&q=80" alt="Professional Indian Psychologist" class="w-full aspect-[4/5] object-cover">
                    </div>
                    <div class="absolute top-10 right-2 sm:-right-8 bg-white/90 backdrop-blur p-4 sm:p-6 rounded-3xl shadow-xl border border-stone-100 max-w-[180px] sm:max-w-[200px] hidden sm:block">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
                            <span class="text-xs font-bold text-stone-400 uppercase tracking-widest">Now Available</span>
                        </div>
                        <p class="text-sm font-serif text-stone-800 leading-tight">Book a chat for as early as today</p>
                    </div>
                </div>
            </section>

            <!-- Trust Numbers -->
            <section class="py-16 bg-gradient-to-r from-slate-800 to-slate-900">
                <div class="max-w-7xl mx-auto px-4 sm:px-6">
                    <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-12 font-serif">Trusted by thousands across India</h2>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 text-center">
                        <div>
                            <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">50+</div>
                            <div class="text-white/80 text-sm sm:text-base">Expert Psychologists</div>
                        </div>
                        <div>
                            <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">1.5k</div>
                            <div class="text-white/80 text-sm sm:text-base">Happy Clients</div>
                        </div>
                        <div>
                            <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">8.1k</div>
                            <div class="text-white/80 text-sm sm:text-base">Sessions Completed</div>
                        </div>
                        <div>
                            <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">10k+</div>
                            <div class="text-white/80 text-sm sm:text-base">Community Strong</div>
                        </div>
                    </div>
                    <p class="text-center text-white/60 mt-8 text-sm max-w-3xl mx-auto">Your privacy is sacred. Every session remains completely confidential between you and your therapist.</p>
                </div>
            </section>

            <!-- Services Grid -->
            <section id="services" class="bg-white py-24">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="text-center mb-16 space-y-4">
                        <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900">What Our Psychologists Can Support You With</h2>
                        <p class="text-stone-500 max-w-2xl mx-auto text-lg">Professional guidance for various life challenges. <strong>Individual outcomes may vary.</strong></p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-[#6B8E7B] hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-[#6B8E7B] group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Work-Related Stress</h3>
                            <p class="text-stone-500 leading-relaxed">Support for managing burnout, performance concerns, and professional challenges.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-orange-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-[#E67E22] group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Relationship Concerns</h3>
                            <p class="text-stone-500 leading-relaxed">Professional support for navigating relationship dynamics and interpersonal challenges.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-indigo-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-indigo-500 group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Stress & Worry Patterns</h3>
                            <p class="text-stone-500 leading-relaxed">Evidence-based support for managing stress and negative thinking patterns.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Team Section -->
            <section id="experts" class="py-24 max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900 mb-6">Our Expert Psychologists</h2>
                    <p class="text-stone-500 max-w-2xl mx-auto">RCI-licensed professionals with proven expertise</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-lekha.webp" alt="Lekha Murali" class="w-full h-full object-cover object-top" width="593" height="949" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Lekha Murali</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">PhD Psychology</p>
                        <p class="text-sm text-stone-500 leading-relaxed">19+ years • Clinical Psychology, Psychotherapy, Guidance Counseling</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-jyotsna.jpg" alt="Dr. Jaismeen Kaur" class="w-full h-full object-cover object-top" width="601" height="800" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Dr. Jaismeen Kaur</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Choice Theory & Reality Therapy</p>
                        <p class="text-sm text-stone-500 leading-relaxed">6+ years • William Glasser Institute (USA) • PhD, MSc, PGDGC</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-jaismeen.jpg" alt="Jyotsna Mohanta" class="w-full h-full object-cover object-top" width="800" height="600" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Jyotsna Mohanta</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">NLP Expert & Life Coach</p>
                        <p class="text-sm text-stone-500 leading-relaxed">7+ years • Mental Wellness, Personal Growth • PhD, MSc, PGDGC</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-sharmila.jpg" alt="Sharmila Masih" class="w-full h-full object-cover object-top" width="424" height="453" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Sharmila Masih</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Clinical Psychologist</p>
                        <p class="text-sm text-stone-500 leading-relaxed">7+ years • Child Development & Mental Health • M.A. Clinical Psychology</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-pooja.webp" alt="Ms. Pooja" class="w-full h-full object-cover object-top" width="400" height="399" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Ms. Pooja</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Relationship & Mental Health Expert</p>
                        <p class="text-sm text-stone-500 leading-relaxed">5+ years • Relationship Counseling, Family Therapy • M.A. Counseling</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-2xl sm:rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-sukriti.webp" alt="Ms. Sukriti" class="w-full h-full object-cover object-top" width="300" height="300" loading="lazy">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Ms. Sukriti</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Clinical & Counseling Psychologist</p>
                        <p class="text-sm text-stone-500 leading-relaxed">7+ years • Organizational Psychology • M.A. Psychology</p>
                    </div>
                </div>
            </section>

            <!-- Testimonials -->
            <section class="py-24 bg-[#F8F5F0]">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-16">
                        <div class="max-w-xl">
                            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900 mb-6">What Our Clients <span class="text-[#6B8E7B] italic">Say</span></h2>
                            <p class="text-stone-600">Real experiences from real people.</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        <div class="bg-white p-6 sm:p-12 rounded-2xl sm:rounded-[3.5rem] shadow-sm flex flex-col justify-between">
                            <div>
                                <div class="flex gap-1 mb-3">
                                    <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                    <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                    <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                    <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                    <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                </div>
                                <p class="text-lg font-serif italic text-stone-700 leading-relaxed">"Highly recommend. The resources and support have been incredibly helpful. One of the best experiences I've had."</p>
                            </div>
                            <div class="mt-10 flex items-center justify-between">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center text-[#D35400] font-bold">AP</div>
                                    <div>
                                        <p class="font-bold text-stone-900">Aarav Patel</p>
                                        <p class="text-sm text-stone-400">Teacher</p>
                                    </div>
                                </div>
                                <span class="text-xs text-green-600 font-semibold flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Verified</span>
                            </div>
                        </div>
                        <div class="bg-white p-6 sm:p-12 rounded-2xl sm:rounded-[3.5rem] shadow-sm flex flex-col justify-between border-2 border-[#6B8E7B]/20">
