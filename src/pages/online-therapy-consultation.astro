---
import Layout from "../layouts/Layout.astro";
import WhyChooseSection from "../components/WhyChooseSection.astro";
import PricingSection from "../components/PricingSection.astro";
import BookingForm from "../components/BookingForm.astro";
---

<Layout
    title="Talk to a Therapist Online | Your Safe Space for Therapy | Psychology Zone"
>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-serif { font-family: 'Lora', serif; }
        .bg-orange-gradient { background: linear-gradient(135deg, #D35400 0%, #E67E22 100%); }
        .text-sage { color: #6B8E7B; }
        .bg-sage { background-color: #6B8E7B; }
        .bg-cream { background-color: #F8F5F0; }
    </style>

    <div class="min-h-screen bg-[#F8F5F0] text-slate-800">
        <!-- Navigation -->
        <nav class="fixed w-full z-50 bg-[#F8F5F0]/90 backdrop-blur-md border-b border-stone-200/60 top-0">
            <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex items-center justify-center p-1.5 bg-orange-50 rounded-lg border border-orange-200">
                        <div class="w-9 h-9 bg-orange-gradient rounded-md flex items-center justify-center shadow-inner transform rotate-3">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="flex flex-col leading-none">
                        <span class="text-2xl font-black text-[#D35400] tracking-tighter" style="font-family: 'Lora', serif;">PSYCHOLOGY</span>
                        <span class="text-sm font-bold text-gray-400 tracking-[0.2em] uppercase -mt-0.5 ml-0.5">ZONE</span>
                    </div>
                </div>
                <div class="hidden lg:flex items-center gap-10 text-sm font-medium text-stone-600">
                    <a href="#approach" id="nav-approach-link" class="hover:text-[#D35400] transition-colors">Our Philosophy</a>
                    <a href="#services" id="nav-services-link" class="hover:text-[#D35400] transition-colors">Support Areas</a>
                    <a href="#therapists" id="nav-therapists-link" class="hover:text-[#D35400] transition-colors">Therapists</a>
                    <a href="#pricing" id="nav-pricing-link" class="hover:text-[#D35400] transition-colors">Pricing</a>
                </div>
                <a href="#pricing" id="nav-book-btn" class="bg-orange-gradient text-white px-7 py-3 rounded-full text-sm font-semibold shadow-lg shadow-orange-200 hover:scale-105 transition-transform">Start My Journey</a>
            </div>
        </nav>

        <main class="pt-20">
            <!-- Hero Section -->
            <section class="max-w-7xl mx-auto px-6 pt-16 pb-24 md:pt-24 md:pb-32 flex flex-col lg:flex-row items-center gap-16">
                <div class="lg:w-1/2 space-y-8">
                    <div class="inline-flex items-center gap-2 bg-[#6B8E7B]/10 text-[#6B8E7B] px-4 py-2 rounded-full text-sm font-medium">
                        <span>A safe, non-judgmental space for you</span>
                    </div>
                    <h1 class="text-5xl md:text-7xl font-serif leading-[1.15] text-stone-900">
                        Talk to a <span class="italic font-medium text-[#D35400]">kind</span> therapist online.
                    </h1>
                    <p class="text-lg md:text-xl text-stone-600 leading-relaxed max-w-xl font-light">
                        Life can be heavy, but you don't have to carry it alone. Connect with empathetic professionals who prioritize your emotional well-being over clinical labels.
                    </p>
                    <div class="flex flex-wrap gap-5">
                        <a href="#pricing" id="hero-cta-primary" class="bg-orange-gradient text-white px-10 py-5 rounded-3xl text-lg font-semibold shadow-xl shadow-orange-100 flex items-center gap-2 group transition-all">
                            Begin Your Journey
                            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                        <div class="flex items-center gap-3 px-6 py-4">
                            <svg class="w-8 h-8 text-[#6B8E7B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                            <span class="text-stone-500 font-medium text-sm">100% Private &<br>Secure Sessions</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 pt-4 border-t border-stone-200 w-fit">
                        <div class="flex -space-x-3">
                            <img src="https://images.unsplash.com/photo-1512485694743-9c9538b4e6e0?auto=format&fit=crop&q=80&w=100" class="w-12 h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
                            <img src="https://images.unsplash.com/photo-1589156229687-496a31ad1d1f?auto=format&fit=crop&q=80&w=100" class="w-12 h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
                            <img src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&q=80&w=100" class="w-12 h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
                        </div>
                        <p class="text-sm text-stone-500 font-medium">Join 1,500+ happy clients finding peace</p>
                    </div>
                </div>
                <div class="lg:w-1/2 relative">
                    <div class="absolute -top-10 -right-10 w-72 h-72 bg-orange-100 rounded-full blur-3xl opacity-50"></div>
                    <div class="absolute -bottom-10 -left-10 w-72 h-72 bg-[#6B8E7B]/20 rounded-full blur-3xl opacity-50"></div>
                    <div class="relative rounded-[3rem] overflow-hidden border-[16px] border-white shadow-2xl transition-transform hover:scale-[1.01] duration-500">
                        <img src="https://images.unsplash.com/photo-1598128558393-70ff21433be0?auto=format&fit=crop&q=80&w=1200" alt="Warm Indian Therapist" class="w-full aspect-[4/5] object-cover">
                    </div>
                    <div class="absolute top-10 -right-8 bg-white/90 backdrop-blur p-6 rounded-3xl shadow-xl border border-stone-100 max-w-[200px]">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
                            <span class="text-xs font-bold text-stone-400 uppercase tracking-widest">Now Available</span>
                        </div>
                        <p class="text-sm font-serif text-stone-800 leading-tight">Book a chat for as early as today</p>
                    </div>
                </div>
            </section>

            <!-- Trust Numbers -->
            <section class="py-16 bg-gradient-to-r from-slate-800 to-slate-900">
                <div class="max-w-7xl mx-auto px-6">
                    <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-12 font-serif">Trusted by thousands across India</h2>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                        <div>
                            <div class="text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">50+</div>
                            <div class="text-white/80">Expert Psychologists</div>
                        </div>
                        <div>
                            <div class="text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">1.5k</div>
                            <div class="text-white/80">Happy Clients</div>
                        </div>
                        <div>
                            <div class="text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">8.1k</div>
                            <div class="text-white/80">Sessions Completed</div>
                        </div>
                        <div>
                            <div class="text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">10k+</div>
                            <div class="text-white/80">Community Strong</div>
                        </div>
                    </div>
                    <p class="text-center text-white/60 mt-8 text-sm max-w-3xl mx-auto">Your privacy is sacred. Every session remains completely confidential between you and your therapist.</p>
                </div>
            </section>

            <!-- Services Grid -->
            <section id="services" class="bg-white py-24">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="text-center mb-16 space-y-4">
                        <h2 class="text-4xl md:text-5xl font-serif text-stone-900">Support for your unique path</h2>
                        <p class="text-stone-500 max-w-2xl mx-auto text-lg">We don't focus on diagnoses. We focus on you and the areas where you're seeking more ease and balance.</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        <div class="group bg-[#F8F5F0]/50 p-10 rounded-[3rem] border border-transparent hover:border-[#6B8E7B] hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-[#6B8E7B] group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Finding Peace in Worry</h3>
                            <p class="text-stone-500 leading-relaxed">Calming techniques and supportive listening for those navigating anxiety and persistent stress.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-10 rounded-[3rem] border border-transparent hover:border-orange-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-[#E67E22] group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Navigating Life Shifts</h3>
                            <p class="text-stone-500 leading-relaxed">Support during transitions—career changes, moves, or identity shifts—to help you find your footing.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-10 rounded-[3rem] border border-transparent hover:border-indigo-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-indigo-500 group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Nurturing Relationships</h3>
                            <p class="text-stone-500 leading-relaxed">Improve communication and build deeper connections with partners, family, and friends.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-10 rounded-[3rem] border border-transparent hover:border-rose-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-rose-500 group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Self-Worth & Confidence</h3>
                            <p class="text-stone-500 leading-relaxed">Unlearning harsh self-criticism and discovering a kinder way to treat yourself every day.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-10 rounded-[3rem] border border-transparent hover:border-amber-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-amber-500 group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Burnout Recovery</h3>
                            <p class="text-stone-500 leading-relaxed">Practical and emotional support for reclaiming your energy and passion in a busy world.</p>
                        </div>
                        <div class="group bg-[#F8F5F0]/50 p-10 rounded-[3rem] border border-transparent hover:border-emerald-400 hover:bg-white transition-all duration-300">
                            <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-emerald-500 group-hover:text-white transition-colors">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-serif mb-4">Personal Growth</h3>
                            <p class="text-stone-500 leading-relaxed">Exploring who you want to be and taking small, brave steps toward a more fulfilling life.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Testimonials -->
            <section class="py-24 bg-[#F8F5F0]">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-16">
                        <div class="max-w-xl">
                            <h2 class="text-4xl md:text-5xl font-serif text-stone-900 mb-6">Small stories of <span class="text-[#6B8E7B] italic">healing</span></h2>
                            <p class="text-stone-600">Hear from people who took the first step and found the support they needed.</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        <div class="bg-white p-12 rounded-[3.5rem] shadow-sm flex flex-col justify-between">
                            <p class="text-lg font-serif italic text-stone-700 leading-relaxed">"Highly recommend. The resources and support have been incredibly helpful. One of the best experiences I've had."</p>
                            <div class="mt-10 flex items-center gap-4">
                                <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center text-[#D35400] font-bold">AP</div>
                                <div>
                                    <p class="font-bold text-stone-900">Aarav Patel</p>
                                    <p class="text-sm text-stone-400">Teacher</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white p-12 rounded-[3.5rem] shadow-sm flex flex-col justify-between border-2 border-[#6B8E7B]/20">
                            <p class="text-lg font-serif italic text-stone-700 leading-relaxed">"I was hesitant at first, but my sessions have made such a difference. My therapist provided a safe space where I could express myself freely. I feel more confident and clear-headed."</p>
                            <div class="mt-10 flex items-center gap-4">
                                <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center text-[#D35400] font-bold">PS</div>
                                <div>
                                    <p class="font-bold text-stone-900">Priya Sharma</p>
                                    <p class="text-sm text-stone-400">Marketing Manager</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white p-12 rounded-[3.5rem] shadow-sm flex flex-col justify-between">
                            <p class="text-lg font-serif italic text-stone-700 leading-relaxed">"From the very first session, I felt heard and understood. My therapist helped me work through what I was feeling, and I've noticed real progress in my confidence and well-being."</p>
                            <div class="mt-10 flex items-center gap-4">
                                <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center text-[#D35400] font-bold">SG</div>
                                <div>
                                    <p class="font-bold text-stone-900">Sneha Gupta</p>
                                    <p class="text-sm text-stone-400">Business Owner</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white p-12 rounded-[3.5rem] shadow-sm flex flex-col justify-between">
                            <p class="text-lg font-serif italic text-stone-700 leading-relaxed">"The sessions have been a game-changer for me. The practical strategies and support I received made all the difference. I now feel more grounded."</p>
                            <div class="mt-10 flex items-center gap-4">
                                <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center text-[#D35400] font-bold">SS</div>
                                <div>
                                    <p class="font-bold text-stone-900">Siddharth Sharma</p>
                                    <p class="text-sm text-stone-400">Lawyer</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white p-12 rounded-[3.5rem] shadow-sm flex flex-col justify-between">
                            <p class="text-lg font-serif italic text-stone-700 leading-relaxed">"I was dealing with a lot of pressure at work, and my therapist helped me find better balance. Their guidance has been invaluable."</p>
                            <div class="mt-10 flex items-center gap-4">
                                <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center text-[#D35400] font-bold">HS</div>
                                <div>
                                    <p class="font-bold text-stone-900">Harshdeep Singh</p>
                                    <p class="text-sm text-stone-400">Athlete</p>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white p-12 rounded-[3.5rem] shadow-sm flex flex-col justify-between">
                            <p class="text-lg font-serif italic text-stone-700 leading-relaxed">"Before reaching out, I wasn't sure what to expect. The guidance and support I received here have given me a fresh perspective. I finally feel heard and supported."</p>
                            <div class="mt-10 flex items-center gap-4">
                                <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center text-[#D35400] font-bold">A</div>
                                <div>
                                    <p class="font-bold text-stone-900">Anonymous</p>
                                    <p class="text-sm text-stone-400">Client</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Therapists Section -->
            <section id="therapists" class="py-24 max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-serif text-stone-900 mb-6">Empathy-First Care</h2>
                    <p class="text-stone-500 max-w-2xl mx-auto">We choose our therapists for their warmth and genuine human connection, as much as their clinical expertise.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <div class="group cursor-pointer">
                        <div class="rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-pooja.webp" alt="Ms. Pooja - Relationship Expert" class="w-full h-full object-cover">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Ms. Pooja</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Relationship & Mental Health Expert</p>
                        <p class="text-sm text-stone-500 leading-relaxed">5+ years • M.A. Counseling • Specializes in relationship counseling and family therapy</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-sukriti.webp" alt="Ms. Sukriti - Clinical Psychologist" class="w-full h-full object-cover">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Ms. Sukriti</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Clinical & Counseling Psychologist</p>
                        <p class="text-sm text-stone-500 leading-relaxed">7+ years • M.A. Psychology • Organizational psychology and personal development</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-jaismeen.jpg" alt="Jyotsna Mohanta" class="w-full h-full object-cover">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Jyotsna Mohanta</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">NLP Expert & Life Coach</p>
                        <p class="text-sm text-stone-500 leading-relaxed">7+ years • PhD, MSc, PGDGC • Mental wellness and personal growth specialist</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-sharmila.jpg" alt="Sharmila Masih" class="w-full h-full object-cover">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Sharmila Masih</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">Clinical Psychologist</p>
                        <p class="text-sm text-stone-500 leading-relaxed">7+ years • M.A. Clinical Psychology • Child development counseling and mental health</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-lekha.webp" alt="Lekha Murali" class="w-full h-full object-cover">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Lekha Murali</h3>
                        <p class="text-[#6B8E7B] font-medium mb-3 italic">PhD Psychology</p>
                        <p class="text-sm text-stone-500 leading-relaxed">19+ years • Clinical psychology, psychotherapy, guidance counseling</p>
                    </div>
                    <div class="group cursor-pointer">
                        <div class="rounded-[3rem] overflow-hidden mb-6 aspect-square opacity-90 group-hover:opacity-100 transition-all duration-500">
                            <img src="/images/therapist-jyotsna.jpg" alt="Dr. Jaismeen Kaur" class="w-full h-full object-cover">
                        </div>
                        <h3 class="text-xl font-bold text-stone-900">Dr. Jaismeen Kaur</h3>
