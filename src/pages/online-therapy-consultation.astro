                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });

        // GTM tracking for CTA clicks
        document.querySelectorAll('[id*="cta"], [id*="price-"]').forEach(button => {
            button.addEventListener('click', () => {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                    event: 'cta_click',
                    page: 'therapy_consultation',
                    button_id: button.id
                });
            });
        });
