---
import Layout from '../layouts/Layout.astro';
import BookingForm from '../components/BookingForm.astro';
---

<Layout title="Psychology Zone - Talk to Licensed Psychologists Online | Confidential Sessions">
  <style>
    body { font-family: 'DM Sans', sans-serif; }
    .font-serif { font-family: 'Lora', serif; }
    .bg-orange-gradient { background: linear-gradient(135deg, #D35400 0%, #E67E22 100%); }
    .text-sage { color: #6B8E7B; }
    .bg-sage { background-color: #6B8E7B; }
    .bg-cream { background-color: #F8F5F0; }
  </style>

  <div class="min-h-screen bg-[#F8F5F0] text-slate-800">
    <!-- Navigation -->
    <nav class="fixed w-full z-50 bg-[#F8F5F0]/90 backdrop-blur-md border-b border-stone-200/60 top-0">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
        <a href="/" class="flex items-center">
          <img src="/logo.png" alt="Psychology Zone" class="h-10 sm:h-12 w-auto" />
        </a>
        <a href="#booking-form" class="bg-orange-gradient text-white px-4 py-2 sm:px-7 sm:py-3 rounded-full text-xs sm:text-sm font-semibold shadow-lg shadow-orange-200 hover:scale-105 transition-transform whitespace-nowrap">Book My Session</a>
      </div>
    </nav>

    <main class="pt-20">
      <!-- Hero Section -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 pb-12 sm:pt-12 sm:pb-16 md:pt-24 md:pb-32 flex flex-col lg:flex-row items-center gap-6 sm:gap-10 lg:gap-16">
        <div class="lg:w-1/2 w-full px-4 sm:px-0 text-center lg:text-left space-y-4 sm:space-y-8">
          <div class="inline-flex items-center gap-2 bg-[#6B8E7B]/10 text-[#6B8E7B] px-3 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs sm:text-sm font-medium mx-auto lg:mx-0">
            <span>Confidential Conversations</span>
          </div>
          <h1 class="text-[2rem] sm:text-5xl md:text-7xl font-serif leading-[1.12] sm:leading-[1.15] text-stone-900 max-w-[14ch] mx-auto lg:mx-0">
            Your journey begins with <span class="italic font-medium text-[#D35400]">being heard</span>
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-stone-600 leading-relaxed max-w-[30ch] sm:max-w-xl font-light mx-auto lg:mx-0">
            Talk to India's leading psychologists from home. A safe, private space where your story matters and you're never judged.
          </p>
          <div class="bg-white border border-stone-200 rounded-3xl w-60 sm:w-72 px-5 py-4 sm:px-6 sm:py-5 mx-auto lg:mx-0 shadow-sm">
            <div class="flex items-end justify-center lg:justify-start gap-1.5">
              <span class="text-2xl text-[#D35400] font-semibold">₹</span>
              <span class="text-5xl sm:text-6xl leading-none text-[#D35400] font-serif font-semibold">599</span>
              <span class="text-stone-500 text-base font-medium mb-1">/ session</span>
            </div>
            <div class="flex items-center justify-center lg:justify-start gap-2 mt-2">
              <span class="text-stone-400 text-sm line-through">₹1,499</span>
              <span class="text-xs font-semibold text-[#6B8E7B] bg-[#6B8E7B]/10 px-3 py-1 rounded-full">Save 60%</span>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row flex-wrap gap-4 sm:gap-5 justify-center lg:justify-start">
            <a href="#booking-form" class="w-72 sm:w-auto bg-orange-gradient text-white px-6 py-3 sm:px-10 sm:py-5 rounded-3xl text-sm sm:text-lg font-semibold shadow-xl shadow-orange-100 flex items-center justify-center gap-2 group transition-all min-h-[44px] mx-auto lg:mx-0">
              Begin Your Journey
              <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
          <div class="flex items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-2 w-full sm:w-fit mx-auto lg:mx-0">
            <div class="flex -space-x-3">
              <img src="https://images.unsplash.com/photo-1512485694743-9c9538b4e6e0?auto=format&fit=crop&q=80&w=100" class="w-10 h-10 sm:w-12 sm:h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
              <img src="https://images.unsplash.com/photo-1589156229687-496a31ad1d1f?auto=format&fit=crop&q=80&w=100" class="w-10 h-10 sm:w-12 sm:h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
              <img src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&q=80&w=100" class="w-10 h-10 sm:w-12 sm:h-12 rounded-full border-4 border-[#F8F5F0] object-cover" alt="Client">
            </div>
            <p class="text-xs sm:text-sm text-stone-500 font-medium">Join 1,500+ happy clients finding peace</p>
          </div>
        </div>
        <div class="lg:w-1/2 relative overflow-hidden w-72 sm:w-96 lg:w-auto mx-auto">
          <div class="absolute -top-10 -right-10 w-72 h-72 bg-orange-100 rounded-full blur-3xl opacity-50"></div>
          <div class="absolute -bottom-10 -left-10 w-72 h-72 bg-[#6B8E7B]/20 rounded-full blur-3xl opacity-50"></div>
          <div class="relative rounded-2xl sm:rounded-[3rem] overflow-hidden border-8 sm:border-[16px] border-white shadow-2xl transition-transform hover:scale-[1.01] duration-500">
            <img src="/images/hero-image.png" alt="Online Therapy" class="w-full aspect-[3/4] sm:aspect-[4/5] object-cover" width="350" height="500" fetchpriority="high" decoding="async">
          </div>
          <div class="absolute top-10 right-2 sm:-right-8 bg-white/90 backdrop-blur p-4 sm:p-6 rounded-3xl shadow-xl border border-stone-100 max-w-[180px] sm:max-w-[200px] hidden sm:block">
            <div class="flex items-center gap-2 mb-2">
              <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
              <span class="text-xs font-bold text-stone-400 uppercase tracking-widest">Now Available</span>
            </div>
            <p class="text-sm font-serif text-stone-800 leading-tight">Book a chat for as early as today</p>
          </div>
        </div>
      </section>

      <!-- Trust Numbers -->
      <section class="py-16 bg-gradient-to-r from-slate-800 to-slate-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
          <h2 class="text-3xl md:text-4xl font-bold text-center text-white mb-12 font-serif">Trusted by thousands across India</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 text-center">
            <div>
              <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">50+</div>
              <div class="text-white/80 text-sm sm:text-base">Expert Psychologists</div>
            </div>
            <div>
              <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">1.5k</div>
              <div class="text-white/80 text-sm sm:text-base">Happy Clients</div>
            </div>
            <div>
              <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">8.1k</div>
              <div class="text-white/80 text-sm sm:text-base">Sessions Completed</div>
            </div>
            <div>
              <div class="text-3xl sm:text-5xl md:text-6xl font-bold text-[#E67E22] mb-2">10k+</div>
              <div class="text-white/80 text-sm sm:text-base">Community Strong</div>
            </div>
          </div>
          <p class="text-center text-white/60 mt-8 text-sm max-w-3xl mx-auto">Your privacy is sacred. Every session remains completely confidential between you and your therapist.</p>
        </div>
      </section>

      <!-- Services Grid -->
      <section id="services" class="bg-white py-24">
        <div class="max-w-7xl mx-auto px-6">
          <div class="text-center mb-16 space-y-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900">Support for Life's Challenges</h2>
            <p class="text-stone-500 max-w-2xl mx-auto text-lg">Whatever you're going through, our specialists offer personalized guidance tailored to your unique situation.</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-[#6B8E7B] hover:bg-white transition-all duration-300">
              <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-[#6B8E7B] group-hover:text-white transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                </svg>
              </div>
              <h3 class="text-2xl font-serif mb-4">Feeling Low</h3>
              <p class="text-stone-500 leading-relaxed">Professional support to help you find clarity and move forward with confidence.</p>
            </div>
            <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-orange-400 hover:bg-white transition-all duration-300">
              <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-[#E67E22] group-hover:text-white transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"/>
                </svg>
              </div>
              <h3 class="text-2xl font-serif mb-4">Stress & Worry</h3>
              <p class="text-stone-500 leading-relaxed">Learn practical tools to feel more grounded and at ease in daily life.</p>
            </div>
            <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-indigo-400 hover:bg-white transition-all duration-300">
              <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-indigo-500 group-hover:text-white transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
              </div>
              <h3 class="text-2xl font-serif mb-4">Relationships</h3>
              <p class="text-stone-500 leading-relaxed">Strengthen connection and communication with the people who matter most.</p>
            </div>
            <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-rose-400 hover:bg-white transition-all duration-300">
              <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-rose-500 group-hover:text-white transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <h3 class="text-2xl font-serif mb-4">Self-Worth & Confidence</h3>
              <p class="text-stone-500 leading-relaxed">Unlearning harsh self-criticism and discovering a kinder way to treat yourself every day.</p>
            </div>
            <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-amber-400 hover:bg-white transition-all duration-300">
              <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-amber-500 group-hover:text-white transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
              </div>
              <h3 class="text-2xl font-serif mb-4">Stress Management</h3>
              <p class="text-stone-500 leading-relaxed">Develop practical coping strategies for work, life, and emotional balance.</p>
            </div>
            <div class="group bg-[#F8F5F0]/50 p-6 sm:p-10 rounded-2xl sm:rounded-[3rem] border border-transparent hover:border-emerald-400 hover:bg-white transition-all duration-300">
              <div class="w-16 h-16 bg-white rounded-3xl flex items-center justify-center mb-8 shadow-sm group-hover:bg-emerald-500 group-hover:text-white transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                </svg>
              </div>
              <h3 class="text-2xl font-serif mb-4">Personal Growth</h3>
              <p class="text-stone-500 leading-relaxed">Exploring who you want to be and taking small, brave steps toward a more fulfilling life.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Our Approach -->
      <section class="py-24 bg-[#F8F5F0] border-y border-stone-200/60">
        <div class="max-w-7xl mx-auto px-6">
          <div class="text-center mb-14 space-y-3">
            <span class="text-xs font-semibold tracking-[0.22em] text-[#6B8E7B] uppercase">Our Approach</span>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900">Professional Support Tailored to You</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <article class="bg-white rounded-2xl sm:rounded-[2rem] overflow-hidden border border-stone-200/70 shadow-sm">
              <img src="/images/anxious-man-indoors-front-view_23-2149729600.jpg" alt="Individual Support" class="w-full h-52 object-cover" loading="lazy" />
              <div class="p-7 sm:p-8">
                <h3 class="text-3xl font-serif text-stone-900 mb-4">Individual Support</h3>
                <p class="text-stone-600 leading-relaxed">Our psychologists offer compassionate guidance to help you navigate challenging times and find your path forward.</p>
              </div>
            </article>

            <article class="bg-white rounded-2xl sm:rounded-[2rem] overflow-hidden border border-stone-200/70 shadow-sm">
              <img src="/images/domestic-conflicts-young-indian-couple-emotionally-arguing-home_116547-91125.jpg" alt="Couples Sessions" class="w-full h-52 object-cover" loading="lazy" />
              <div class="p-7 sm:p-8">
                <h3 class="text-3xl font-serif text-stone-900 mb-4">Couples & Relationship Sessions</h3>
                <p class="text-stone-600 leading-relaxed">Strengthen your relationship through better communication. Our therapists help couples understand each other and build stronger connections.</p>
              </div>
            </article>

            <article class="bg-white rounded-2xl sm:rounded-[2rem] overflow-hidden border border-stone-200/70 shadow-sm">
              <img src="/images/about-image.jpg" alt="Professional Consultation" class="w-full h-52 object-cover" loading="lazy" />
              <div class="p-7 sm:p-8">
                <h3 class="text-3xl font-serif text-stone-900 mb-4">Professional Consultation</h3>
                <p class="text-stone-600 leading-relaxed">Get expert guidance from qualified professionals who can help you understand your options and create a personalized plan.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- What Our Sessions Can Look Like -->
      <section class="py-24 bg-[#F8F5F0]">
        <div class="max-w-7xl mx-auto px-6">
          <div class="text-center mb-14 space-y-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900">What Our Sessions Can Look Like</h2>
            <p class="text-stone-500 text-lg">Explore different ways we support you on your journey.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <article class="bg-white rounded-2xl sm:rounded-[2rem] border border-stone-200/70 shadow-sm overflow-hidden">
              <div class="p-8 pb-4">
                <h3 class="text-3xl text-stone-500 mb-3">Individual Sessions</h3>
                <h4 class="text-5xl font-serif text-stone-900">Clarity & Self-Understanding</h4>
              </div>
              <img src="/images/transform-individual.webp" alt="Individual Sessions" class="w-full h-72 object-contain object-bottom" loading="lazy" />
            </article>

            <article class="bg-white rounded-2xl sm:rounded-[2rem] border border-stone-200/70 shadow-sm overflow-hidden">
              <div class="p-8 pb-4">
                <h3 class="text-3xl text-stone-500 mb-3">Couples Sessions</h3>
                <h4 class="text-5xl font-serif text-stone-900">Better Communication</h4>
              </div>
              <img src="/images/transform-couple.webp" alt="Couples Sessions" class="w-full h-72 object-contain object-bottom" loading="lazy" />
            </article>

            <article class="bg-white rounded-2xl sm:rounded-[2rem] border border-stone-200/70 shadow-sm overflow-hidden">
              <div class="p-8 pb-4">
                <h3 class="text-3xl text-stone-500 mb-3">Personal Growth</h3>
                <h4 class="text-5xl font-serif text-stone-900">Motivation & Direction</h4>
              </div>
              <img src="/images/transform-teen.webp" alt="Personal Growth" class="w-full h-72 object-contain object-bottom" loading="lazy" />
            </article>

            <article class="bg-white rounded-2xl sm:rounded-[2rem] border border-stone-200/70 shadow-sm overflow-hidden">
              <div class="p-8 pb-4">
                <h3 class="text-3xl text-stone-500 mb-3">Mindfulness Support</h3>
                <h4 class="text-5xl font-serif text-stone-900">Inner Peace & Balance</h4>
              </div>
              <img src="/images/transform-meditation.webp" alt="Mindfulness" class="w-full h-72 object-contain object-bottom" loading="lazy" />
            </article>
          </div>
        </div>
      </section>

      <!-- Testimonials -->
      <section id="testimonials" class="py-24 bg-[#F8F5F0]">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-16">
            <div class="max-w-xl">
              <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900 mb-6">What Our Clients <span class="text-[#6B8E7B] italic">Say</span></h2>
              <p class="text-stone-600">Real experiences from real people who took the first step.</p>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="bg-white p-6 sm:p-12 rounded-2xl sm:rounded-[3.5rem] shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex gap-1 mb-3">
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
