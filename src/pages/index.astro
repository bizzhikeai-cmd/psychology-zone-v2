---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Psychology Zone - Talk to Licensed Psychologists Online | Confidential Sessions">
  <!-- Header -->
  <header class="header">
    <div class="container">
      <nav class="nav">
        <a href="/" class="logo">
          <img src="/logo.png" alt="Psychology Zone" class="logo-img" width="200" height="45" />
        </a>
        <div class="nav-spacer"></div>
        <a href="tel:+918968900002" class="phone-link">
          <span class="phone-icon">📞</span>
          <span class="phone-number">+91 89689 00002</span>
        </a>
        <a href="#contact" class="btn btn-primary">Book My Session</a>
      </nav>
    </div>
  </header>

  <main>
  <!-- Hero Section - UI Optimized -->
  <section id="home" class="hero">
    <div class="hero-bg-shape"></div>
    <div class="hero-bg-shape-2"></div>
    <div class="container">
      <div class="hero-content">
        <span class="hero-label">Confidential Conversations</span>
        <h1>
          <span class="hero-line">Your journey</span>
          <span class="hero-line">begins with</span>
          <span class="hero-line hero-emphasis">being heard</span>
        </h1>
        
        <p>Talk to India's leading psychologists from home. A safe, private space where your story matters and you're never judged.</p>
        
        <!-- Value Props - Quick Scan -->
        <div class="hero-benefits">
          <span class="benefit-tag">✓ Licensed Experts</span>
          <span class="benefit-tag">✓ 100% Private</span>
        </div>

        <!-- Price with Badge -->
        <div class="price-display">
          <div class="price-badge">Limited Offer</div>
          <div class="price-main">
            <span class="price-currency">₹</span>
            <span class="price-amount">599</span>
            <span class="price-slash">/</span>
            <span class="price-label">session</span>
          </div>
          <div class="price-original">
            <span class="strike">₹1,499</span>
            <span class="savings">Save 60%</span>
          </div>
        </div>

        <!-- Primary CTA -->
        <a href="#contact" class="btn btn-primary btn-large cta-pulse">Begin Your Journey</a>
        
        <!-- Reassurance -->
        <p class="hero-reassurance">🔒 Your privacy is our priority</p>
      </div>
      <div class="hero-image">
        <div class="hero-image-blob"></div>
        <img src="/images/hero-image.png" alt="Online Therapy" class="hero-img" width="350" height="500" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <!-- Experts Help Section -->
  <section class="experts-help">
    <div class="section-decorative-shape"></div>
    <div class="container">
      <div class="section-header-centered">
        <span class="section-eyebrow">How We Can Help</span>
        <h2>Support for Life's Challenges</h2>
        <p class="section-lead">Whatever you're going through, our specialists offer personalized guidance tailored to your unique situation.</p>
      </div>
      
      <div class="help-cards-asymmetric">
        <div class="help-card-modern" style="background-image: url('/images/help-depression.webp');">
          <div class="help-card-gradient"></div>
          <div class="help-card-content">
            <h3>Feeling Low</h3>
            <p>Professional support to help you find clarity and move forward with confidence.</p>
          </div>
        </div>

        <div class="help-card-modern help-card-elevated" style="background-image: url('/images/help-anxiety.webp');">
          <div class="help-card-gradient"></div>
          <div class="help-card-content">
            <h3>Stress & Worry</h3>
            <p>Learn practical tools to feel more grounded and at ease in daily life.</p>
          </div>
        </div>

        <div class="help-card-modern" style="background-image: url('/images/help-relationship.jpg');">
          <div class="help-card-gradient"></div>
          <div class="help-card-content">
            <h3>Relationships</h3>
            <p>Strengthen connection and communication with the people who matter most.</p>
          </div>
        </div>

        <div class="help-card-modern help-card-wide" style="background-image: url('/images/help-stress.jpg');">
          <div class="help-card-gradient"></div>
          <div class="help-card-content">
            <h3>Stress Management</h3>
            <p>Develop practical coping strategies for work, life, and emotional balance.</p>
          </div>
        </div>
      </div>

      <div class="services-intro">
        <h3>More Ways We Can Help</h3>
        <p>Professional guidance for whatever life brings your way</p>
      </div>

      <!-- Service Illustration Cards -->
      <div class="services-grid-modern">
        <div class="service-card-minimal">
          <div class="service-icon-modern">
            <img src="/images/service-depression.webp" alt="Depression & Low Mood" width="200" height="200" loading="lazy" />
          </div>
          <h3>Emotional Support</h3>
          <p>Find clarity and emotional balance</p>
        </div>

        <div class="service-card-minimal">
          <div class="service-icon-modern">
            <img src="/images/Enhancing-Self-Esteem-Psychologists-and-Therapists.webp" alt="Building Self-Worth" width="200" height="200" loading="lazy" />
          </div>
          <h3>Confidence</h3>
          <p>Embrace your strengths fully</p>
        </div>

        <div class="service-card-minimal">
          <div class="service-icon-modern">
            <img src="/images/service-anxiety.webp" alt="Feeling Calm" width="200" height="200" loading="lazy" />
          </div>
          <h3>Finding Calm</h3>
          <p>Tools to feel more at ease</p>
        </div>

        <div class="service-card-minimal">
          <div class="service-icon-modern">
            <img src="/images/coping-with-grief.webp" alt="Focus & Clarity" width="200" height="200" loading="lazy" />
          </div>
          <h3>Focus & Clarity</h3>
          <p>Improve productivity and mindset</p>
        </div>

        <div class="service-card-minimal">
          <div class="service-icon-modern">
            <img src="/images/healing Trauma & PTSD.webp" alt="Past Experiences" width="200" height="200" loading="lazy" />
          </div>
          <h3>Processing the Past</h3>
          <p>Move forward with support</p>
        </div>

        <div class="service-card-minimal">
          <div class="service-icon-modern">
            <img src="/images/service-stress.webp" alt="Work-Life Balance" width="200" height="200" loading="lazy" />
          </div>
          <h3>Life Balance</h3>
          <p>Navigate work and personal life</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet Our Experts Section -->
  <section id="experts" class="section experts">
    <div class="experts-bg-shape"></div>
    <div class="container">
      <div class="section-header-split">
        <div>
          <span class="section-eyebrow">Our Team</span>
          <h2>Meet Your Support Team</h2>
        </div>
        <p class="section-lead-side">50+ compassionate professionals, each bringing years of expertise and a deep commitment to your wellbeing.</p>
      </div>
      
      <div class="experts-grid">
        <div class="expert-card">
          <div class="expert-image-container">
            <img src="/images/therapist-lekha.webp" alt="Lekha Murali" class="expert-img" width="300" height="300" loading="lazy" />
            <span class="expert-exp-badge">19+ Yrs of Exp</span>
          </div>
          <span class="expert-title">Experienced Therapist | 19+ Years in Psychology & Counseling</span>
          <h3>Lekha Murali</h3>
          <p class="expert-desc">PhD in Psychology with 19+ years of expertise in clinical psychology, psychotherapy, and guidance counseling</p>
          <div class="expert-tags">
            <span>PhD</span>
            <span>MSc</span>
            <span>MS</span>
            <span>PGDGC</span>
          </div>
        </div>

        <div class="expert-card">
          <div class="expert-image-container">
            <img src="/images/therapist-jyotsna.jpg" alt="Dr. Jaismeen Kaur" class="expert-img" width="300" height="300" loading="lazy" />
            <span class="expert-exp-badge">6+ Yrs of Exp</span>
          </div>
          <span class="expert-title">Certified Choice Theory & Reality Therapy Practitioner</span>
          <h3>Dr. Jaismeen Kaur</h3>
          <p class="expert-desc">Trained at the William Glasser Institute (USA), serving at RGNUL with 6+ years of therapy and counseling experience.</p>
          <div class="expert-tags">
            <span>PhD</span>
            <span>MSc</span>
            <span>MS</span>
            <span>PGDGC</span>
          </div>
        </div>

        <div class="expert-card">
          <div class="expert-image-container">
            <img src="/images/therapist-jaismeen.jpg" alt="Jyotsna Mohanta" class="expert-img" width="300" height="300" loading="lazy" />
            <span class="expert-exp-badge">7+ Yrs of Exp</span>
          </div>
          <span class="expert-title">NLP Expert | Life & Mental Wellness Coach</span>
          <h3>Jyotsna Mohanta</h3>
          <p class="expert-desc">Certified NLP expert and life coach with 7+ years of experience in mental wellness, personal growth, and transformative coaching.</p>
          <div class="expert-tags">
            <span>PhD</span>
            <span>MSc</span>
            <span>MS</span>
            <span>PGDGC</span>
          </div>
        </div>

        <div class="expert-card">
          <div class="expert-image-container">
            <img src="/images/therapist-sharmila.jpg" alt="Sharmila Masih" class="expert-img" width="300" height="300" loading="lazy" />
            <span class="expert-exp-badge">7+ Yrs of Exp</span>
          </div>
          <span class="expert-title">Clinical Psychologist | Child Development & Counseling Expert</span>
          <h3>Sharmila Masih</h3>
          <p class="expert-desc">M.A. in Clinical Psychology, PGD in Child Development Counseling, with 7+ years of experience in mental health and therapeutic support.</p>
          <div class="expert-tags">
            <span>M.A.</span>
          </div>
        </div>

        <div class="expert-card">
          <div class="expert-image-container">
            <img src="/images/therapist-pooja.webp" alt="Ms. Pooja" class="expert-img" width="300" height="300" loading="lazy" />
            <span class="expert-exp-badge">5+ Yrs of Exp</span>
          </div>
          <span class="expert-title">Relationship & Mental Health Expert</span>
          <h3>Ms. Pooja</h3>
          <p class="expert-desc">Specialized in relationship counseling, family therapy, and mental wellness with 5+ years of professional experience.</p>
          <div class="expert-tags">
            <span>M.A.</span>
            <span>Counseling</span>
          </div>
        </div>

        <div class="expert-card">
          <div class="expert-image-container">
            <img src="/images/therapist-sukriti.webp" alt="Ms. Sukriti" class="expert-img" width="300" height="300" loading="lazy" />
            <span class="expert-exp-badge">7+ Yrs of Exp</span>
          </div>
          <span class="expert-title">Specialized in Clinical, Counseling, and Organizational Psychology</span>
          <h3>Ms. Sukriti</h3>
          <p class="expert-desc">M.A. in Psychology | Specializing in Clinical, Counseling, and Organizational Psychology for holistic mental well-being.</p>
          <div class="expert-tags">
            <span>M.A.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats">
    <div class="stats-texture"></div>
    <div class="container">
      <h2 class="stats-headline">Trusted by thousands across India</h2>
      
      <div class="stats-grid-modern">
        <div class="stat-item">
          <div class="stat-visual">
            <span class="stat-number-large">50</span>
            <span class="stat-plus">+</span>
          </div>
          <div class="stat-label">Expert Psychologists</div>
        </div>
        
        <div class="stat-item">
          <div class="stat-visual">
            <span class="stat-number-large">1.5</span>
            <span class="stat-plus">k</span>
          </div>
          <div class="stat-label">Happy Clients</div>
        </div>
        
        <div class="stat-item">
          <div class="stat-visual">
            <span class="stat-number-large">8.1</span>
            <span class="stat-plus">k</span>
          </div>
          <div class="stat-label">Sessions Completed</div>
        </div>
        
        <div class="stat-item">
          <div class="stat-visual">
            <span class="stat-number-large">10</span>
            <span class="stat-plus">k+</span>
          </div>
          <div class="stat-label">Community Strong</div>
        </div>
      </div>
      
      <p class="stats-reassurance">Your privacy is sacred. Every session remains completely confidential between you and your therapist.</p>
    </div>
  </section>

  <!-- Transform Section -->
  <section class="section transform">
    <div class="container">
      <h2>What Our Sessions Can Look Like</h2>
      <p class="section-subtitle">Explore different ways we support you on your journey.</p>
      
      <div class="transform-grid">
        <div class="transform-card">
          <div class="transform-text">
            <h3>Individual Sessions</h3>
            <h4>Clarity & Self-Understanding</h4>
          </div>
          <img src="/images/transform-individual.webp" alt="Individual Sessions" class="transform-img" width="600" height="400" loading="lazy" />
        </div>

        <div class="transform-card">
          <div class="transform-text">
            <h3>Couples Sessions</h3>
            <h4>Better Communication</h4>
          </div>
          <img src="/images/transform-couple.webp" alt="Couples Sessions" class="transform-img" width="600" height="400" loading="lazy" />
        </div>

        <div class="transform-card">
          <div class="transform-text">
            <h3>Personal Growth</h3>
            <h4>Motivation & Direction</h4>
          </div>
          <img src="/images/transform-teen.webp" alt="Personal Growth" class="transform-img" width="600" height="400" loading="lazy" />
        </div>

        <div class="transform-card">
          <div class="transform-text">
            <h3>Mindfulness Support</h3>
            <h4>Inner Peace & Balance</h4>
          </div>
          <img src="/images/transform-meditation.webp" alt="Mindfulness" class="transform-img" width="600" height="400" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section id="testimonials" class="section testimonials">
    <div class="container">
      <h2>What Our Clients Say</h2>
      <p class="section-subtitle">Real experiences from real people.</p>
      
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <p>"Highly recommend. The resources and support have been incredibly helpful. One of the best experiences I've had."</p>
          <div class="testimonial-author">
            <strong>Aarav Patel</strong>
            <span>Teacher</span>
          </div>
        </div>

        <div class="testimonial-card">
          <p>"I was hesitant at first, but my sessions have made such a difference. My therapist provided a safe space where I could express myself freely. I feel more confident and clear-headed."</p>
          <div class="testimonial-author">
            <strong>Priya Sharma</strong>
            <span>Marketing Manager</span>
          </div>
        </div>

        <div class="testimonial-card">
          <p>"From the very first session, I felt heard and understood. My therapist helped me work through what I was feeling, and I've noticed real progress in my confidence and well-being."</p>
          <div class="testimonial-author">
            <strong>Sneha Gupta</strong>
            <span>Business Owner</span>
          </div>
        </div>

        <div class="testimonial-card">
          <p>"The sessions have been a game-changer for me. The practical strategies and support I received made all the difference. I now feel more grounded."</p>
          <div class="testimonial-author">
            <strong>Siddharth Sharma</strong>
            <span>Lawyer</span>
          </div>
        </div>

        <div class="testimonial-card">
          <p>"I was dealing with a lot of pressure at work, and my therapist helped me find better balance. Their guidance has been invaluable."</p>
          <div class="testimonial-author">
            <strong>Harshdeep Singh</strong>
            <span>Athlete</span>
          </div>
        </div>

        <div class="testimonial-card">
          <p>"Before reaching out, I wasn't sure what to expect. The guidance and support I received here have given me a fresh perspective. I finally feel heard and supported."</p>
          <div class="testimonial-author">
            <strong>Anonymous</strong>
            <span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Therapies Section -->
  <section id="therapies" class="section therapies">
    <div class="container">
      <span class="section-label">OUR APPROACH</span>
      <h2>Professional Support Tailored to You</h2>
      
      <div class="therapies-grid">
        <div class="therapy-card">
          <img src="/images/anxious-man-indoors-front-view_23-2149729600.jpg" alt="Individual Support" class="therapy-img" width="600" height="400" loading="lazy" />
          <h3>Individual Support</h3>
          <p>Our psychologists offer compassionate guidance to help you navigate challenging times and find your path forward.</p>
        </div>

        <div class="therapy-card">
          <img src="/images/domestic-conflicts-young-indian-couple-emotionally-arguing-home_116547-91125.jpg" alt="Couples Sessions" class="therapy-img" width="600" height="400" loading="lazy" />
          <h3>Couples & Relationship Sessions</h3>
          <p>Strengthen your relationship through better communication. Our therapists help couples understand each other and build stronger connections.</p>
        </div>

        <div class="therapy-card">
          <img src="/images/about-image.jpg" alt="Professional Consultation" class="therapy-img" width="600" height="400" loading="lazy" />
          <h3>Professional Consultation</h3>
          <p>Get expert guidance from qualified professionals who can help you understand your options and create a personalized plan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Take the First Step?</h2>
      <a href="#contact" class="btn btn-primary btn-large">Book Your Session</a>
    </div>
  </section>



  <!-- Booking Section -->
  <section id="contact" class="section booking">
    <div class="container">
      <span class="section-label">BOOK YOUR SESSION</span>
      <h2>Start Your Journey Today</h2>
      <p class="section-subtitle">Complete the form below to book your confidential session</p>
      
      <div class="booking-content">
        <form id="bookingForm" class="booking-form">
          <!-- Problem Selection -->
          <div class="form-group">
            <label for="problem">What would you like support with? *</label>
            <select id="problem" name="problem" required>
              <option value="">Select an area</option>
              <option value="feeling-low">Feeling Low</option>
              <option value="stress-worry">Stress & Worry</option>
              <option value="relationship">Relationships</option>
              <option value="work-life">Work-Life Balance</option>
              <option value="negative-thoughts">Negative Thinking Patterns</option>
              <option value="overthinking">Overthinking</option>
              <option value="emotions">Managing Emotions</option>
              <option value="fears">Fears & Concerns</option>
              <option value="career">Career Direction</option>
              <option value="eating-habits">Eating Habits</option>
              <option value="past-experiences">Past Experiences</option>
              <option value="motivation">Motivation & Goals</option>
              <option value="parenting">Parenting</option>
              <option value="personal-growth">Personal Growth</option>
              <option value="confidence">Building Confidence</option>
              <option value="intimacy">Intimacy & Connection</option>
              <option value="purpose">Finding Purpose</option>
              <option value="sleep">Sleep Patterns</option>
              <option value="frustration">Managing Frustration</option>
            </select>
          </div>

          <!-- Circumstances -->
          <div class="form-group">
            <label for="circumstances">Briefly describe your situation *</label>
            <textarea id="circumstances" name="circumstances" rows="4" placeholder="Tell us more about what you're experiencing..." required></textarea>
          </div>

          <!-- Name and Phone -->
          <div class="form-row">
            <div class="form-group">
              <label for="name">Full Name *</label>
              <input type="text" id="name" name="name" placeholder="Your full name" required />
            </div>
            <div class="form-group">
              <label for="phone">Phone Number *</label>
              <input type="tel" id="phone" name="phone" placeholder="Your phone number" required />
            </div>
          </div>

          <!-- Email and City -->
          <div class="form-row">
            <div class="form-group">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="email" placeholder="Your email address" required />
            </div>
            <div class="form-group">
              <label for="city">City *</label>
              <input type="text" id="city" name="city" placeholder="Your city" required />
            </div>
          </div>

          <!-- Date and Time -->
          <div class="form-row">
            <div class="form-group">
              <label for="date">Preferred Date *</label>
              <input type="date" id="date" name="date" required />
            </div>
            <div class="form-group">
              <label for="time">Preferred Time *</label>
              <select id="time" name="time" required>
                <option value="">Select a time slot</option>
                <option value="09:00">09:00 AM</option>
                <option value="09:30">09:30 AM</option>
                <option value="10:00">10:00 AM</option>
                <option value="10:30">10:30 AM</option>
                <option value="11:00">11:00 AM</option>
                <option value="11:30">11:30 AM</option>
                <option value="12:00">12:00 PM</option>
                <option value="12:30">12:30 PM</option>
                <option value="14:00">02:00 PM</option>
                <option value="14:30">02:30 PM</option>
                <option value="15:00">03:00 PM</option>
                <option value="15:30">03:30 PM</option>
                <option value="16:00">04:00 PM</option>
                <option value="16:30">04:30 PM</option>
                <option value="17:00">05:00 PM</option>
                <option value="17:30">05:30 PM</option>
                <option value="18:00">06:00 PM</option>
                <option value="18:30">06:30 PM</option>
                <option value="19:00">07:00 PM</option>
                <option value="19:30">07:30 PM</option>
                <option value="20:00">08:00 PM</option>
                <option value="20:30">08:30 PM</option>
                <option value="21:00">09:00 PM</option>
              </select>
            </div>
          </div>

          <!-- Price Display -->
          <div class="price-summary">
            <div class="price-item">
              <span>Session Cost</span>
              <span class="price-value">Rs. 599/-</span>
            </div>
          </div>

          <!-- Error Message -->
          <div id="formError" class="form-error" style="display: none;"></div>

          <!-- Submit Button -->
          <button type="submit" class="btn btn-primary btn-large" style="width: 100%;">Proceed For Payment</button>

          <p class="form-disclaimer">Your information is secure and confidential. We'll contact you to confirm your booking.</p>
        </form>

        <div class="booking-info">
          <img src="/images/Online-consulting.webp" alt="Online Consulting" />
          <h3>Why Choose Psychology Zone?</h3>
          <ul class="benefits-list">
            <li>✓ 50+ Expert Psychologists</li>
            <li>✓ Confidential & Secure Sessions</li>
            <li>✓ Flexible Scheduling</li>
            <li>✓ Affordable Pricing</li>
            <li>✓ 24/7 Support Available</li>
            <li>✓ Money-Back Guarantee</li>
          </ul>
          <p style="margin-top: 20px; color: var(--text-light); font-size: 0.9rem;">Questions? Call us at <a href="tel:+918968900002" style="color: var(--primary-color); font-weight: 600;">+91 89689 00002</a></p>
        </div>
      </div>
    </div>
  </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-brand">
          <p style="font-size: 1.3rem; font-weight: 700; margin-bottom: 15px;">Psychology<span style="color: var(--primary-color);">Zone</span></p>
          <p>Your partner in mental well-being – Providing accessible, comprehensive support for a healthier mind and life.</p>
        </div>
        
        <div class="footer-cta">
          <h4>Ready to Start Your Journey?</h4>
          <p>Take the first step towards better mental health today.</p>
          <a href="#contact" class="btn btn-primary">Book My Session</a>
        </div>
        
        <div class="footer-connect">
