# Psychology Zone - Environment Variables
# Copy this file to .env and fill in your actual values
#
# ⚠️  IMPORTANT FORMAT RULES:
# - NO newlines in values (validation will catch this)
# - NO trailing/leading whitespace
# - Use quotes only if value contains spaces
# - Run `npm run validate-env` to check before deployment

# ===========================================
# RAZORPAY PAYMENT GATEWAY
# ===========================================
# Get from: https://dashboard.razorpay.com/app/keys
# Use test keys for development (rzp_test_xxx)
# Use live keys for production (rzp_live_xxx)
#
# Format: Must start with rzp_test_ or rzp_live_ followed by alphanumeric
# Example: RAZORPAY_KEY_ID=rzp_test_1234567890
# Example: RAZORPAY_KEY_SECRET=abcdef1234567890 (min 20 chars, alphanumeric only)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# SUPABASE DATABASE
# ===========================================
# Get from: https://app.supabase.com/project/YOUR_PROJECT/settings/api-keys
#
# Format: SUPABASE_URL must be HTTPS and end with .supabase.co
# Format: Keys must be valid JWT tokens starting with eyJ
# Example: SUPABASE_URL=https://yourproject.supabase.co
# Example: SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://yourprojectid.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ===========================================
# INTERAKT WHATSAPP API
# ===========================================
# Get from: https://app.interakt.ai/settings/api-keys
#
# Format: Minimum 10 characters
# ⚠️  NO newlines! Validation will fail if corrupted
INTERAKT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp message template names (must be approved in Interakt)
# Format: Template name as configured in Interakt dashboard
INTERAKT_CUSTOMER_TEMPLATE=appointment_confirmation
INTERAKT_ADMIN_TEMPLATE=new_booking_admin
INTERAKT_ABANDONED_TEMPLATE=booking_reminder

# Admin WhatsApp number for notifications
# Format: Country code + number, NO + symbol or spaces
# Example: ADMIN_WHATSAPP_NUMBER=918968900002 (10-15 digits)
ADMIN_WHATSAPP_NUMBER=918968900002

# ===========================================
# GOOGLE TAG MANAGER
# ===========================================
# Get from: https://tagmanager.google.com
#
# Format: Must start with GTM- followed by alphanumeric
# Example: GTM_CONTAINER_ID=GTM-ABC123XY
GTM_CONTAINER_ID=GTM-XXXXXXX

# ===========================================
# ADMIN DASHBOARD
# ===========================================
# Password for admin login at /admin/login
#
# Format: Minimum 8 characters, no spaces
# Example: ADMIN_PASSWORD=SecurePass123
ADMIN_PASSWORD=your_secure_admin_password_here

# Admin email(s) for booking notifications
# Format: Valid email addresses, comma-separated for multiple
# Example: ADMIN_EMAIL=admin1@example.com,admin2@example.com
# ⚠️  NO spaces around commas!
ADMIN_EMAIL=admin@example.com

# Session token (auto-generated, leave empty)
ADMIN_SESSION_TOKEN=

# ===========================================
# EMAIL NOTIFICATIONS (RESEND)
# ===========================================
# Get from: https://resend.com/api-keys
#
# Format: Must start with re_ followed by alphanumeric
# Example: RESEND_API_KEY=re_abc123xyz
# ⚠️  CRITICAL: NO newlines! This broke production before!
# ⚠️  Run validation before syncing to Vercel
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# CRON JOB SECURITY (Optional)
# ===========================================
# Secret for authenticating cron job requests
#
# Format: Minimum 16 characters for security
# Example: CRON_SECRET=my-random-secret-key-123456
CRON_SECRET=

# ===========================================
# SITE CONFIGURATION
# ===========================================
# Your production domain
#
# Format: Must be HTTPS URL with NO trailing slash
# Example: SITE_URL=https://book.psychologyzone.in
# ❌ Wrong: SITE_URL=https://book.psychologyzone.in/ (has trailing slash)
SITE_URL=https://book.psychologyzone.in

# ===========================================
# PRICING CONFIGURATION
# ===========================================
# Set to 'true' to show bundle packages (STARTER/POPULAR/PREMIUM)
# Set to 'false' to show single ₹599 per session pricing
# Example: ENABLE_BUNDLE_PRICING=false (default: simplified single pricing)
ENABLE_BUNDLE_PRICING=false

# Price in paise for single session (₹599 = 59900 paise)
# Format: Integer value in paise (multiply rupees by 100)
# Example: SINGLE_SESSION_PRICE=59900 (₹599)
SINGLE_SESSION_PRICE=59900

# ===========================================
# NOTION CRM INTEGRATION
# ===========================================
# Pushes every booking attempt as a row in Notion so you can track leads.
# Payment Status = Pending on form submit → Confirmed after successful payment.
#
# Setup steps:
# 1. Go to https://www.notion.so/my-integrations → create an Internal Integration
# 2. Copy the "Internal Integration Secret" as NOTION_API_KEY
# 3. Run: NOTION_API_KEY=secret_xxx node scripts/setup-notion.js
# 4. Copy the printed NOTION_DATABASE_ID below
#
# Leave blank to disable Notion sync (bookings still work normally)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# VALIDATION & DEPLOYMENT
# ===========================================
#
# Before deploying to production:
# 1. Run: npm run validate-env
# 2. Fix any errors reported
# 3. Test on staging first
# 4. Then deploy to production
#
# To sync to Vercel safely:
# 1. Run: npm run sync-env:dry-run (shows changes without applying)
# 2. Review changes carefully
# 3. Run: npm run sync-env (applies changes)
# 4. Redeploy: vercel --prod
#
# Common validation errors:
# - "Contains newline" → Variable has \n in it, will break services
# - "Invalid format" → Check example format above
# - "Missing required variable" → Must be set for production
